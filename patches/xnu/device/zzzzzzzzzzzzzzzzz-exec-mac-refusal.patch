# Board patch: the exec of launchd refused by a MAC policy module.
#
# 21H461 first light ended in kern_sig.c's initproc guard:
#   panic_plain("unexpected SIGKILL of launchd ... namespace 9 code 0x8")
# OS_REASON_EXEC (9) + EXIT_REASON code 8 (EXEC_EXIT_REASON_SECURITY_POLICY,
# bsd/sys/reason.h) is raised in two places in process_signature():
#
#   - the imgp->ip_mac_return branch, which builds the reason with no payload
#     -- that is why the panic prints "description none";
#   - proc_process_signature(), which carries the reason string when
#     machine_task_process_signature() fails.
#
# "description none" therefore names the first branch: a MAC policy module
# refused cred_label_update_execve, not taskgated.
#
# This board passes amfi_get_out_of_my_way=1, so the refusal is logged and
# cleared: the label is not what stands between this kernel and the screen,
# and the staging it would gate has no source on this port yet.  The
# taskgated/machine-signature branch still vetoes, and now reports why.
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8419 +8419 @@
-	kern_return_t kr = machine_task_process_signature(proc_get_task_raw(p), proc_platform(p), proc_sdk(p), &error_msg);
+	kern_return_t kr = machine_task_process_signature(proc_get_task_raw(p), proc_platform(p), proc_sdk(p), &error_msg); if (kr != KERN_SUCCESS) printf("[nio] proc_process_signature failed: kr=%d msg=%s\n", kr, error_msg ? error_msg : "(none)");
@@ -8495,2 +8495,6 @@
 	if (imgp->ip_mac_return != 0) {
+		printf("[nio] exec MAC refusal on '%s': ip_mac_return=%d csflags=0x%x\n", p->p_name, imgp->ip_mac_return, proc_getcsflags(p));
+		imgp->ip_mac_return = 0;
+	}
+	if (imgp->ip_mac_return != 0) {
 		KERNEL_DEBUG_CONSTANT(BSDDBG_CODE(DBG_BSD_PROC, BSD_PROC_EXITREASON_CREATE) | DBG_FUNC_NONE,
