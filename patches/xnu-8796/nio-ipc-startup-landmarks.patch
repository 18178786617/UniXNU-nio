+	printf("nio: ipc_init before ipc_host_init\n");
 	ux_handler_init();
+	printf("nio: ipc_init after ux_handler_init\n");
 }
 STARTUP(MACH_IPC, STARTUP_RANK_LAST, ipc_init);
