 	assert(kr == KERN_SUCCESS);
+	printf("nio: ipc_init kernel space done\n");
 
 	kr = ipc_space_create_special(&ipc_space_reply);
 	assert(kr == KERN_SUCCESS);
+	printf("nio: ipc_init reply space done\n");
 
