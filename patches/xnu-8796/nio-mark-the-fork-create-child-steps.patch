nio: mark the steps inside fork_create_child

Run 600 still stops at "CP pre-fork_create_child" with no "post", so the
blocking call is inside fork_create_child() itself, not the return-wait
handshake (clearing TRW_LRETURNWAIT in run 600 did not help).

Put panel marks around task_create_internal(), main_thread_create_waiting()
and thread_yield_internal() to name the exact call that does not come back.
A forward declaration of nio_fmark() is needed because it is defined later
in this file.  Diagnosis only, no behaviour change.

diff --git a/bsd/kern/kern_fork.c b/bsd/kern/kern_fork.c
index f47aa25..6217023 100644
--- a/bsd/kern/kern_fork.c
+++ b/bsd/kern/kern_fork.c
@@ -441,6 +441,9 @@ bad:
  *		in the system, it's possible for 'parent_task' to be TASK_NULL;
  *		in this case, 'inherit_memory' MUST be FALSE.
  */
+/* nio: forward decl of panel mark helper (defined later in this file). */
+static void nio_fmark(const char *s);
+
 thread_t
 fork_create_child(task_t parent_task,
     coalition_t *parent_coalitions,
@@ -467,6 +470,7 @@ fork_create_child(task_t parent_task,
 	 * Create a new task for the child process, IPC access to the new task will
 	 * be set up after task has been fully initialized.
 	 */
+	nio_fmark("\nnio: FC pre-task_create");
 	result = task_create_internal(parent_task,
 	    proc_ro,
 	    parent_coalitions,
@@ -484,6 +488,8 @@ fork_create_child(task_t parent_task,
 		goto bad;
 	}
 
+	nio_fmark("\nnio: FC post-task_create");
+
 	/* Set the child proc process to child task */
 	proc_set_task(child_proc, child_task);
 
@@ -509,6 +515,7 @@ fork_create_child(task_t parent_task,
 	 *
 	 * The new thread is waiting on the event triggered by 'task_clear_return_wait'
 	 */
+	nio_fmark("\nnio: FC pre-main_thread");
 	result = main_thread_create_waiting(child_task,
 	    (thread_continue_t)task_wait_to_return,
 	    task_get_return_wait_event(child_task),
@@ -521,12 +528,15 @@ fork_create_child(task_t parent_task,
 		child_task = NULL;
 	}
 
+	nio_fmark("\nnio: FC post-main_thread");
+
 	/*
 	 * Tag thread as being the first thread in its task.
 	 */
 	thread_set_tag(child_thread, THREAD_TAG_MAINTHREAD);
 
 bad:
+	nio_fmark("\nnio: FC pre-yield");
 	thread_yield_internal(1);
 
 	return child_thread;
