The phases of bsd_init and the exec marks go to the panel straight

The panel of run 546 showed the matching's marks and not one of bsd_init's
own phases, even though the matching runs on another thread while bsd_init
runs on this one and the two write at the same time.  The matching's marks
go straight to the framebuffer through the console blob's own writer, and
bsd_init's phases go through printf, which goes into the console's ring
buffer.  The ring is where the boot stopped, so the phases were written
into it and never came out.

So they say themselves on the panel now, the way the matching's marks do:
no lock, no ring.  The panel will say whether this thread got as far as
the root volume -- "calling setconf", "vfs_mountroot", "calling VFS_ROOT"
-- and whether the kernel ever reached the door of the userland, which is
what the exec marks are for:

  nio: exec: exec_mach_imgact enter
  nio: exec: load_init_program_at_path /sbin/launchd
  nio: exec: load_init_program enter

The phase on the panel carries the text as it was written, so a message
with a number in it shows the number's place and not its value; the one
in the console has the value.  Both are written, so nothing is lost.

The struct mirrors osfmk/console/serial_protos.h's struct console_ops,
which neither of these files includes -- the layout is what matters, and
the symbol is the one serial_console.c defines.

The two helpers are at file scope.  The first attempt put them where the
print they replace was, and in both files that place is inside a
function: bsd_init's macro sits in the body of a function, and the exec
mark sits in exec_mach_imgact.  C does not allow a function definition
inside a function, and the build said so: "function definition is not
allowed here".  The checker knows about that now: it reads the tree,
looks for a definition at a brace depth above zero in a C file, and
compares what it finds with what the tree the series started from had.

--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -480,6 +480,26 @@
 volatile uint32_t native_apfs_registered = 0;
 volatile uintptr_t native_apfs_vfsops = 0;
 
+
+/* nio: a mark on the panel, straight through the console blob's own writer.
+ *
+ * The struct mirrors osfmk/console/serial_protos.h's struct console_ops,
+ * which this file does not include -- the layout is what matters, and the
+ * symbol is the one serial_console.c defines. */
+struct nio_wd_console_ops {
+	void (*putc)(char, bool);
+	int (*getc)(bool);
+};
+extern struct nio_wd_console_ops cons_ops[];
+
+static void
+nio_bmark(const char *s)
+{
+	while (*s != '\0') {
+		cons_ops[1].putc(*s++, true);
+	}
+}
+
 __attribute__((noinline)) void
 native_apfs_probe_checkpoint(void)
 {
@@ -582,7 +602,30 @@
 #if DEBUG_BSDINIT
 #define bsd_init_kprintf(x, ...) kprintf("bsd_init: " x, ## __VA_ARGS__)
 #else
-#define bsd_init_kprintf(x, ...) printf("nio: bsd_init: " x, ## __VA_ARGS__)
+#define bsd_init_kprintf(x, ...)
 #endif
+
+/* nio: the phase on the panel and the phase in the console.  The one on the
+ * panel carries the text as it was written, so a message with a number in it
+ * shows the number's place and not its value; the one in the console has the
+ * value.  Both are written, so nothing is lost.
+ *
+ * The panel of run 546 showed the matching's marks and not one of these, and
+ * the matching runs on another thread while bsd_init runs on this one, so the
+ * two were writing to the same place at the same time: the direct marks went
+ * to the framebuffer and these went into the console's ring, and the ring is
+ * where the boot stopped.  So the phases say themselves on the panel now, and
+ * they say whether this thread got as far as the root volume.
+ *
+ * This definition has to sit after the #endif.  It used to sit in the #else
+ * branch, and another patch of this series sets DEBUG_BSDINIT to 1, so the
+ * branch was dead: the core of run 554 carries "bsd_init: " 43 times, which
+ * is XNU's own definition, and "nio: bsd_init: " not at all, so no phase
+ * mark of this series ever reached the kernel. */
+#undef bsd_init_kprintf
+#define bsd_init_kprintf(x, ...) do { \
+	nio_bmark("\nnio: bsd_init: " x); \
+	printf("nio: bsd_init: " x, ## __VA_ARGS__); \
+} while (0)
 
 	throttle_init();
