index 6127866..7ba85df 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -417,7 +417,7 @@ event_register_handler(struct event_hdr *hdr)
  * is alive; a frozen tail with no new HB lines says the kernel stopped. */
 extern struct console_ops cons_ops[];
 
