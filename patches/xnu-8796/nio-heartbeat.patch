Start a heartbeat thread so a silent screen is distinguishable

The stop point moves between boots with the same patches (kalloc, then sysctl,
then vm_compressor, then the claim table), which reads like memory corruption
rather than one missing feature.  A thread that prints every 100 ms tells the
two cases apart: heartbeats continuing mean the kernel is alive and only the
current path is quiet; heartbeats stopping mean it really died, and the last
number dates the death.
---
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index bec97fb..5c269ca 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -391,11 +391,33 @@ event_register_handler(struct event_hdr *hdr)
 	head->next = hdr;
 }
 
+static void
+nio_heartbeat_thread(void *arg, wait_result_t wr)
+{
+	unsigned n = 0;
+	for (;;) {
+		delay(100);
+		printf("nio: hb %u\n", ++n);
+	}
+}
+
 __startup_func
 void
 kernel_startup_initialize_upto(startup_subsystem_id_t upto)
 {
 	struct startup_entry *cur = startup_entry_cur;
+	static bool nio_hb_started = false;
+
+	if (!nio_hb_started && startup_phase >= STARTUP_SUB_EARLY_BOOT) {
+		thread_t th = THREAD_NULL;
+		nio_hb_started = true;
+		if (kernel_thread_start(nio_heartbeat_thread, NULL, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+			printf("nio: hb thread started\n");
+		} else {
+			printf("nio: hb thread failed\n");
+		}
+	}
 
 	assert(startup_phase < upto);
 
