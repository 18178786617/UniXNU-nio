diff --git a/libkern/c++/OSKext.cpp b/libkern/c++/OSKext.cpp
--- a/libkern/c++/OSKext.cpp
+++ b/libkern/c++/OSKext.cpp
@@ -6090,6 +6090,53 @@
 		goto finish;
 	}
 
+	/* nio: AppleImage4 cannot start without /chosen/manifest-properties.
+	 *
+	 * run-50 got one whole layer further: with the kernel's __DATA_CONST
+	 * left writable (R264) CoreTrust's constructor and its os_log counter
+	 * store both went through, and the boot then reached the next kext
+	 * IOKit asked for. That one dies inside its own start():
+	 *
+	 *   IOService::probeCandidates -> OSKext::loadKextWithIdentifier
+	 *   -> OSKext::load -> OSKext::start
+	 *   -> com.apple.security.AppleImage4 __TEXT_EXEC+0xd420
+	 *   panic: failed to get mix-n-match policy: 2
+	 *
+	 * AppleImage4 reads the img4 manifest properties that iBoot writes to
+	 * /chosen/manifest-properties. This board boots from a device tree of
+	 * our own making (tools/make-nio-adt.py), so the node is absent, the
+	 * property lookup returns 2 and the kext panics on the way in. It is
+	 * the same wall the security-extension loader already avoids for AMFI
+	 * (see nio-skip-security-extensions.patch), just reached through IOKit
+	 * matching instead of the explicit mac_policy_initmach() load.
+	 *
+	 * With no manifest there is nothing this kext could enforce, so it is
+	 * skipped unconditionally on this port. The skip used to be gated on
+	 * the nio_skip_security_extensions boot arg, which never worked: the
+	 * loader hands the command line over as UTF-16 and the kernel saw a
+	 * single "-" (see nio-boot-args-fallback.patch), so every boot arg on
+	 * this port has been dead from the start.
+	 */
+	{
+		extern const char *PE_boot_args_raw(void);
+		const char *nio_id = kextIdentifier ?
+		    kextIdentifier->getCStringNoCopy() : "(null)";
+
+		printf("nio: kext load id=[%s] cmd=[%s] raw=[%s] parsed=%d\n",
+		    nio_id,
+		    PE_boot_args(),
+		    PE_boot_args_raw(),
+		    PE_parse_boot_argn("nio_skip_security_extensions", NULL, 0));
+	}
+	if (kextIdentifier != NULL &&
+	    strcmp(kextIdentifier->getCStringNoCopy(),
+	    "com.apple.security.AppleImage4") == 0) {
+		printf("nio: not loading com.apple.security.AppleImage4, "
+		    "its start needs /chosen/manifest-properties\n");
+		result = kOSKextReturnNotFound;
+		goto finish;
+	}
+
 	OSKext::recordIdentifierRequest(kextIdentifier);
 
 	theKext = OSDynamicCast(OSKext, sKextsByID->getObject(kextIdentifier));
