Print the coalescing equation when a chunk cannot be grown
---
diff --git a/osfmk/vm/vm_kern.c b/osfmk/vm/vm_kern.c
index 2927d4b..db45157 100644
--- a/osfmk/vm/vm_kern.c
+++ b/osfmk/vm/vm_kern.c
@@ -2891,6 +2891,9 @@ kmem_get_new_chunk(
 			if (adj_free_meta->km_page_marker != KMEM_META_FREE ||
 			    kmem_get_free_chunk_len(adj_free_meta) !=
 			    meta_req - meta_num) {
+				printf("\nA q=%u n=%u f=%u m=%x\n", meta_req, meta_num,
+				    kmem_get_free_chunk_len(adj_free_meta),
+				    adj_free_meta->km_page_marker);
 				return NULL;
 			}
 		}
