Name each candidate before it is instantiated

run-292 shows the batches are one or two candidates, so the stall is inside a
single one.  Print the class name on the way in; the line after it is either
'cand done' or nothing at all, which names the class that never comes back.
---
diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 6d7dd7e..81fd162 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -3988,6 +3988,7 @@ IOService::probeCandidates( OSOrderedSet * matches )
 				//IOLog("%s alloc (symbol %p props %p)\n", symbol->getCStringNoCopy(), IOSERVICE_OBFUSCATE(symbol), IOSERVICE_OBFUSCATE(props));
 
 				// alloc the driver instance
+				printf("\nnio: C %s", symbol ? symbol->getCStringNoCopy() : "?");
 				inst = (IOService *) OSMetaClass::allocClassWithName( symbol);
 
 				if (!inst || !OSDynamicCast(IOService, inst)) {
@@ -4068,6 +4069,7 @@ IOService::probeCandidates( OSOrderedSet * matches )
 				if (startList) {
 					startList->setObject( newInst );
 				}
+				printf("\nnio: cand done %s", symbol ? symbol->getCStringNoCopy() : "?");
 			} while (false);
 
 			props->release();
