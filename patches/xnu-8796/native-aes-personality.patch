+#if defined(XNU_NATIVE_VIRTIO_BLOCK) && XNU_NATIVE_VIRTIO_BLOCK
+    "   ,{"
+    "     'IOClass'         = NativeVirtioBlock;"
+    "     'IOProviderClass' = IOPlatformDevice;"
+    "     'IOProbeScore'    = 1000:32;"
+    "   }"
+#endif
+#if defined(XNU_NATIVE_VIRTIO_CONSOLE) && XNU_NATIVE_VIRTIO_CONSOLE
+    "   ,{"
