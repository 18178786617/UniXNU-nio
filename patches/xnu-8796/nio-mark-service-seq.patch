Number the marks by service, so one screen says whether matching moves

run-373 is all L1 L2 and U1 U2T U3 from other threads, and the panel alone
cannot say whether the thread that printed B IOC moves on.  Counting services
and stamping every mark with that number makes a single screen answer it: the
last number visible is how far matching got, and if it stops changing the loop
is on one service.

nio_svc_seq increments in start(), B prints it, and nio_u_seq() stamps it onto
L1, L2, U1, U2T, U2B and U3.
---
diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 0673f28..3388c04 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -94,6 +94,8 @@ enum{
  * declaration; without it the compiler stops with one "use of undeclared
  * identifier" per call, which is what run-342 hit and left in the series. */
 static void nio_u_mark(const char *s);
+static void nio_u_seq(void);
+static unsigned nio_svc_seq;
 
 OSDefineMetaClassAndStructors(IOService, IORegistryEntry)
 
@@ -1135,12 +1137,26 @@ IOService::startMatching( IOOptionBits options )
 	 * invisible, so progress has to be measured without it. */
 	{
 		const char *nio_n = getName();
-		char nio_b[8];
-		nio_b[0] = '\n'; nio_b[1] = 'B'; nio_b[2] = ' ';
-		nio_b[3] = (nio_n && nio_n[0]) ? nio_n[0] : '?';
-		nio_b[4] = (nio_n && nio_n[1]) ? nio_n[1] : ' ';
-		nio_b[5] = (nio_n && nio_n[2]) ? nio_n[2] : ' ';
-		nio_b[6] = '\0';
+		char nio_b[16];
+		char nio_d[8];
+		int nio_p = 0;
+		int nio_k = 0;
+		unsigned nio_v;
+		nio_svc_seq += 1;
+		nio_v = nio_svc_seq;
+		do {
+			nio_d[nio_k++] = (char)('0' + (nio_v % 10u));
+			nio_v /= 10u;
+		} while (nio_v != 0);
+		nio_b[nio_p++] = '\n'; nio_b[nio_p++] = 'B';
+		while (nio_k > 0) {
+			nio_b[nio_p++] = nio_d[--nio_k];
+		}
+		nio_b[nio_p++] = ' ';
+		nio_b[nio_p++] = (nio_n && nio_n[0]) ? nio_n[0] : '?';
+		nio_b[nio_p++] = (nio_n && nio_n[1]) ? nio_n[1] : ' ';
+		nio_b[nio_p++] = (nio_n && nio_n[2]) ? nio_n[2] : ' ';
+		nio_b[nio_p] = '\0';
 		nio_u_mark(nio_b);
 	}
 	printf("\nnio: SM enter %s t=%p", getName() ? getName() : "?", current_thread());
@@ -1696,10 +1712,10 @@ IOService::lockForArbitration( bool isSuccessRequired )
 	/* nio: the lock side of the arbitration had no marks, so a thread that
 	 * stops here looks exactly like a console failure -- the panel shows
 	 * 'B Arm' and then nothing.  L1 before the take, L2 once it is held. */
-	nio_u_mark("\nL1");
+	nio_u_mark("\nL1"); nio_u_seq();
 	// lock global access
 	IOTakeLock( gArbitrationLockQueueLock );
-	nio_u_mark(" L2");
+	nio_u_mark(" L2"); nio_u_seq();
 
 	// obtain an unused queue element
 	if (!queue_empty( &gArbitrationLockQueueFree )) {
@@ -1978,11 +1994,11 @@ IOService::unlockForArbitration( void )
 	 * down), U2B means another thread holds it and the matching thread waits
 	 * here forever.  The blocking take still follows, so the kernel keeps
 	 * its old behaviour. */
-	nio_u_mark("\nnio: U1");
+	nio_u_mark("\nU1"); nio_u_seq();
 	if (IOLockTryLock( gArbitrationLockQueueLock )) {
-		nio_u_mark(" U2T");
+		nio_u_mark(" U2T"); nio_u_seq();
 	} else {
-		nio_u_mark(" U2B");
+		nio_u_mark(" U2B"); nio_u_seq();
 		IOTakeLock( gArbitrationLockQueueLock );
 	}
 
@@ -2056,7 +2072,7 @@ IOService::unlockForArbitration( void )
 	/* nio: the function ran to the end.  run-370 showed U1 U2T over and over,
 	 * so the global lock is free and this path repeats; U3 says whether each
 	 * of those calls also returns. */
-	nio_u_mark(" U3");
+	nio_u_mark(" U3"); nio_u_seq();
 }
 
 uint32_t
@@ -3959,6 +3975,26 @@ nio_u_mark(const char * s)
 	}
 }
 
+/* nio: every mark carries the number of the service being started, so a screen
+ * full of marks can still be read: the last number is how far matching got. */
+static void
+nio_u_seq(void)
+{
+	char b[8];
+	unsigned v = nio_svc_seq;
+	int i = 7;
+	b[i] = '\0';
+	if (v == 0) {
+		b[--i] = '0';
+	}
+	while (v != 0 && i > 0) {
+		b[--i] = (char)('0' + (v % 10u));
+		v /= 10u;
+	}
+	nio_u_mark(" #");
+	nio_u_mark(&b[i]);
+}
