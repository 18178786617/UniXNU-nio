+ * Both are needed.  The boot thread of run 561 stopped at 8: between
+ * vm_set_restrictions() and bsd_init() the only thing left is
+ * kperf_init_early(), whose first act is ml_wait_max_cpus() -- a wait for
+ * every CPU to be accounted for.  Only IOKit publishes that count:
+ * ml_set_max_cpus() is called from AppleARMSMP and from IOCPU, and only a
+ * personality that was probed and attached calls either.  So the boot thread
+ * waits for the matching, and the matching has to finish.
+ */
+volatile int nio_boot_waypoint = 0;
+volatile int nio_match_waypoint = 0;
+
 /* nio: a beacon that never sleeps.  The heartbeat thread below uses delay(),
  * which needs working timers; it prints HB 1 and stops, and that tells us
  * nothing about whether the kernel is alive.  This one spins on its own and
@@ -455,6 +507,18 @@ nio_beacon_thread(void *arg, wait_result_t wr)
 			nio_dc_puts("V");
 			nio_dc_putu(++mark);
 			nio_dc_puts(" ");
+			/* nio: where the boot thread and the matching thread are.
+			 *
+			 * The count is the beacon's own: the clock does not
