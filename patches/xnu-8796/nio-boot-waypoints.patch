Where the boot thread stopped, said once a second

The panel of run 555 ends with the console's last line and not one of
bsd_init's phases, even though those phases are written to the panel before
they are written to the console.  So the boot thread never reached the first
phase of bsd_init: it stopped between the IOKit lockdown and the start of
bsd_init, and nothing on the panel says where.

Run 556 put the waypoint on the heartbeat and the panel showed nothing: the
heartbeat uses delay(), which needs timers that are not running yet, so it
prints HB 1 and stops -- its own patch says so.  Run 559 put it on the
beacon, which does keep writing, but only once every sixty-four marks, and
the panel was cut exactly there: the last mark on the panel was 5360 and the
waypoint had been written at 5312.  It is written once a second now, on the
clock.

  w0  before the IOKit lockdown
  w1  after the IOKit lockdown, before vm_set_restrictions()
  w2  after vm_set_restrictions()
  w3  at the call of bsd_init()
  w4  at the top of bsd_init(), before boot_progress_stage()
  w5  after boot_progress_stage()
  w6  after platform_stall_panic_or_spin()
  w7  after throttle_init()
  w8  after the copyright is printed

w7 would mean the boot thread is stuck in the console write of the
copyright, which is the one thing on that path that can block: the console
ring is drained by the writer itself, and the flush lock is held while the
characters are written to the device, so a device that does not take them
keeps every other thread waiting on that lock.

diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index 134b095..e589cd0 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -439,6 +439,35 @@ nio_dc_putu(unsigned long v)
 	nio_dc_puts(&buf[i]);
 }
 
+/* nio: where the boot thread is.
+ *
+ * The panel of run 555 ends with the console's last line and not one of
+ * bsd_init's phases, even though those phases are written to the panel
+ * before they are written to the console.  So the boot thread never reached
+ * the first phase of bsd_init: it stopped between the IOKit lockdown and
+ * the start of bsd_init, and nothing on the panel says where.
+ *
+ * The beacon is the one that can carry it.  The heartbeat uses delay(),
+ * which needs timers that are not running yet, so it prints HB 1 and stops
+ * -- its own patch says so -- and run 556 put the waypoint there and the
+ * panel showed nothing.  The beacon spins, so it keeps writing.
+ *
+ * It writes the waypoint once a second, on the clock and not on a counter
+ * of its own: run 559 wrote it once every sixty-four marks and the panel
+ * happened to be cut exactly there, between mark 5312 and mark 5329.
+ *
+ * 0  before the IOKit lockdown
+ * 1  after the IOKit lockdown, before vm_set_restrictions()
+ * 2  after vm_set_restrictions()
+ * 3  at the call of bsd_init()
+ * 4  at the top of bsd_init(), before boot_progress_stage()
+ * 5  after boot_progress_stage()
+ * 6  after platform_stall_panic_or_spin()
+ * 7  after throttle_init()
+ * 8  after the copyright is printed
+ */
+volatile int nio_boot_waypoint = 0;
+
 /* nio: a beacon that never sleeps.  The heartbeat thread below uses delay(),
  * which needs working timers; it prints HB 1 and stops, and that tells us
  * nothing about whether the kernel is alive.  This one spins on its own and
@@ -449,6 +478,7 @@ nio_beacon_thread(void *arg, wait_result_t wr)
 {
 	volatile unsigned long n = 0;
 	unsigned long mark = 0;
+	uint64_t last_report = 0;
 	for (;;) {
 		n++;
 		if ((n % 2000000ul) == 0) {
@@ -456,6 +486,17 @@ nio_beacon_thread(void *arg, wait_result_t wr)
 			nio_dc_putu(++mark);
 			nio_dc_puts(" ");
 		}
+		/* nio: the waypoint, once a second. */
+		{
+			uint64_t now = 0;
+			clock_get_uptime(&now);
+			if ((now - last_report) >= 1000000000ULL) {
+				last_report = now;
+				nio_dc_puts("w");
+				nio_dc_putu((unsigned)nio_boot_waypoint);
+				nio_dc_puts(" ");
+			}
+		}
 	}
 }
 
@@ -941,12 +982,14 @@ kernel_bootstrap_thread(void)
 		}
 	}
 	printf("\nR4 iokit lockdown");
+	nio_boot_waypoint = 1;
 #endif
 	/*
 	 * max_cpus must be nailed down by the time PE_lockdown_iokit() finishes,
 	 * at the latest
 	 */
 	vm_set_restrictions(machine_info.max_cpus);
+	nio_boot_waypoint = 2;
 
 
 #if KPERF
@@ -957,6 +1000,7 @@ kernel_bootstrap_thread(void)
 	 *	Start the user bootstrap.
 	 */
 #ifdef  MACH_BSD
+	nio_boot_waypoint = 3;
 	bsd_init();
 	printf("\nR5 bsd_init enter");
 #endif
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
