Mark every step from E16 to bsd_init

E16 is STARTUP_SUB_EARLY_BOOT, the last startup phase, and nothing after it was
marked.  With the console now scrolling, run-256's bottom line is authoritative
and reads E4294967295 (STARTUP_SUB_LOCKDOWN) followed by the kext 'keepsyms ...
keeping linkedit segment' message, so the boot is in the lockdown tail and the
next call is unmarked.

One short line per step: Q2..QA through the early-boot calls, then R1 after the
LOCKDOWN phase, R4 after PE_lockdown_iokit and R5 just before bsd_init().
---
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index bec97fb..b1310b6 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -702,21 +702,26 @@ kernel_bootstrap_thread(void)
 	ml_spin_debug_clear_self();
 #endif
 	(void) spllo();         /* Allow interruptions */
+	printf("\nQ2");
 
 	/*
 	 * This will start displaying progress to the user, start as early as possible
 	 */
 	initialize_screen(NULL, kPEAcquireScreen);
+	printf("\nQ3");
 
 	/*
 	 *	Initialize the shared region module.
 	 */
 	vm_commpage_init();
+	printf("\nQ4");
 	vm_commpage_text_init();
+	printf("\nQ5");
 
 #if CONFIG_MACF
 	kernel_bootstrap_log("mac_policy_initmach");
 	mac_policy_initmach();
+	printf("\nQ6");
 #if CONFIG_VNGUARD
 	kernel_bootstrap_log("vnguard_policy_init");
 	vnguard_policy_init();
@@ -727,6 +732,7 @@ kernel_bootstrap_thread(void)
 	kernel_bootstrap_log("dtrace_early_init");
 	dtrace_early_init();
 	sdt_early_init();
+	printf("\nQ7");
 #endif
 
 #if CODE_SIGNING_MONITOR
@@ -739,12 +745,14 @@ kernel_bootstrap_thread(void)
 
 	/* Initialize the runtime for the trust cache interface */
 	trust_cache_runtime_init();
+	printf("\nQ8");
 
 	/* Load the static and engineering trust caches */
 	load_static_trust_cache();
 #endif
 
 	kernel_startup_initialize_upto(STARTUP_SUB_LOCKDOWN);
+	printf("\nR1 lockdown phase");
 
 	/*
 	 * Get rid of segments used to bootstrap kext loading. This removes
@@ -754,10 +762,12 @@ kernel_bootstrap_thread(void)
 	 */
 	kernel_bootstrap_log("OSKextRemoveKextBootstrap");
 	OSKextRemoveKextBootstrap();
+	printf("\nQ9");
 
 	/* No changes to kernel text and rodata beyond this point. */
 	kernel_bootstrap_log("machine_lockdown");
 	machine_lockdown();
+	printf("\nQA");
 
 #ifdef CONFIG_XNUPOST
 	kern_return_t result = kernel_list_tests();
@@ -771,6 +781,7 @@ kernel_bootstrap_thread(void)
 #ifdef  IOKIT
 	kernel_bootstrap_log("PE_lockdown_iokit");
 	PE_lockdown_iokit();
+	printf("\nR4 iokit lockdown");
 #endif
 	/*
 	 * max_cpus must be nailed down by the time PE_lockdown_iokit() finishes,
@@ -788,6 +799,7 @@ kernel_bootstrap_thread(void)
 	 */
 #ifdef  MACH_BSD
 	bsd_init();
+	printf("\nR5 bsd_init enter");
 #endif
 
 
