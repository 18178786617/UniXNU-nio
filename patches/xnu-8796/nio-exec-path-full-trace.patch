+/* nio: direct console writer, so the ladder survives a busy console.
+ * The struct mirrors serial_console.c's console_ops layout; cons_ops is
+ * the symbol that file defines. */
+struct nio_wd_console_ops { void (*putc)(char, bool); int (*getc)(bool); };
+extern struct nio_wd_console_ops cons_ops[];
+static void nio_lmark(const char *s) { while (*s) cons_ops[1].putc(*s++, true); }
+static void nio_lhex(unsigned v)
+{
+	int i;
