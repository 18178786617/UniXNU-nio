Time the matching trace from the continuous timebase

clock_get_boottime_microtime turned out to be the wrong clock: it returns
clock_boottime, which the kernel only updates when the system time is set
(osfmk/kern/clock.c:787), so on this board it never moves -- three
consecutive prints showed the same microsecond.  The system clock does move
but its zero is the device's real-time clock, not the boot.

clock_get_uptime() returns mach_absolute_time(), the same continuous
timebase the kernel uses for its own timeouts and delays, and it is what has
to be measured against.
---
diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index ec90d7d..eb51788 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -3822,15 +3822,13 @@ IOService::probeCandidates( OSOrderedSet * matches )
 	{
 		static uint32_t nio_probe_cand;
 		if ((++nio_probe_cand & 0x0u) == 0) {
-			clock_sec_t nio_sec;
-			clock_nsec_t nio_usec;
-			uint32_t nio_now = 0;
+			uint64_t nio_abstime = 0, nio_ns = 0;
 
-			clock_get_boottime_microtime(&nio_sec, &nio_usec);
-			nio_now = nio_usec + (uint32_t)(nio_sec % 1000) * 1000000u;
+			clock_get_uptime(&nio_abstime);
+			absolutetime_to_nanoseconds(nio_abstime, &nio_ns);
 			printf("\nM%u/%d %s %u", nio_probe_cand,
 			    matches ? matches->getCount() : -1,
-			    getName() ? getName() : "?", nio_now);
+			    getName() ? getName() : "?", (uint32_t)(nio_ns / 1000));
 		}
 		if (nio_probe_cand >= 200000u) {
 			panic("nio: probeCandidates entered %u times", nio_probe_cand);
