Say when a candidate has no class to allocate

No nio: C, no cand done and no nio: P means the loop body is never entered, so
the personality has no gIOClassKey at all.  This marks that branch.
---
diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 6d7dd7e..914487b 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -3982,6 +3982,7 @@ IOService::probeCandidates( OSOrderedSet * matches )
 				symbol = OSDynamicCast( OSSymbol,
 				    props->getObject( gIOClassKey));
 				if (!symbol) {
+					printf("\nnio: N %s", props->getObject(gIONameKey) ? "named" : "anon");
 					continue;
 				}
 
