Print rank and function for every ZALLOC entry, not just rank LAST

The last F line was F9ad2cc.a5e310 -- __zone_site_register again -- and the very
next entry printed the token [784:7.55], a rank of 55 that the rank==LAST filter
skipped.  That skipped entry is the one that does not return.

Widen the filter to the whole subsystem and put rank first, so the last line
names both the rank that is stalling and the function it belongs to.
---
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -420,5 +420,9 @@ kernel_startup_initialize_upto(startup_subsystem_id_t upto)
 				printf("\n[#%u:%u.%u]", nio_this, cur->subsystem,
 				    (unsigned)(cur->rank % 100u));
 			}
 		}
+		if (cur->subsystem == STARTUP_SUB_ZALLOC) {
+			printf("\nF%x.%x", (unsigned)cur->rank,
+			    (unsigned)((uintptr_t)cur->func & 0xffffffu));
+		}
 		cur->func(cur->arg);
