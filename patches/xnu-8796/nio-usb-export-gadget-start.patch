nio: export gadget_start under the name bsd_init calls

Run 657 failed to link: _nio_usb_gadget_start was undefined.  The ECM
full-file patch carried sweet's `static void sweet_usb_gadget_start(...)`:
wrong name (bsd_init calls nio_usb_gadget_start) and static (not visible
outside the file).  Rename every reference and drop static so it links.

diff --git a/bsd/dev/nio_usb.c b/bsd/dev/nio_usb.c
--- a/bsd/dev/nio_usb.c
+++ b/bsd/dev/nio_usb.c
@@ -35,8 +35,8 @@
 #include <netinet/in.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
-void sweet_usb_probe(void);
-static void sweet_usb_gadget_start(vm_offset_t dwc);
+void nio_usb_gadget_probe(void);
+void nio_usb_gadget_start(vm_offset_t dwc);
 extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 
 #define GCC_PA                  0x00100000
@@ -71,7 +71,7 @@ usb_rd(vm_offset_t base, uint32_t off)
 }
 
 void
-sweet_usb_probe(void)
+nio_usb_gadget_probe(void)
 {
 	int enabled = 1;
 	uint32_t gdscr, cbcr[sizeof(usb_cbcr) / sizeof(usb_cbcr[0])];
@@ -114,7 +114,7 @@ sweet_usb_probe(void)
 	    usb_rd(dwc, 0xc404), usb_rd(dwc, 0xc400), usb_rd(dwc, 0xc408), usb_rd(dwc, 0xc40c),
 	    usb_rd(dwc, 0xc140));
 	if (enabled >= 2) {
-		sweet_usb_gadget_start(dwc);
+		nio_usb_gadget_start(dwc);
 	}
 	if (cbcr[5] & CBCR_CLK_OFF) {
 		printf("nio: USB: ahb2phy clock off; QUSB2 PHY not read\n");
@@ -812,7 +812,7 @@ ud_log_thread(void *arg __unused, wait_result_t wr __unused)
 	}
 }
 
-static void
-sweet_usb_gadget_start(vm_offset_t dwc)
+void
+nio_usb_gadget_start(vm_offset_t dwc)
 {
 	thread_t thread;
