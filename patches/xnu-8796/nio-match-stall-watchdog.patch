diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 3316a98..7c409df 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -3878,6 +3878,42 @@ nio_reason_rank(int reason)
 	} \
 } while (0)
 
+/* nio: the matching path's progress, and the thread that watches it.
+ *
+ * A silent panel cannot say whether the kernel stopped or the console
+ * stopped, and console_write() waits for room in the console ring buffer
+ * (osfmk/console/serial_console.c:555).  So the matching rounds are counted
+ * here, and a thread watches the count: when it stands still the kernel
+ * panics, and the panic screen is drawn by the console blob straight into
+ * the framebuffer, so it appears even when the console is what is stuck. */
+static volatile uint32_t nio_match_progress;
+
+static void
+nio_match_watchdog(void *arg, wait_result_t wr)
+{
+	uint32_t last = 0;
+	uint64_t since = 0;
+	uint64_t abstime = 0, ns = 0;
+
+	for (;;) {
+		delay(100);
+
+		clock_get_uptime(&abstime);
+		absolutetime_to_nanoseconds(abstime, &ns);
+
+		if (nio_match_progress != last) {
+			last = nio_match_progress;
+			since = ns;
+			continue;
+		}
+		if (since && (ns - since) >= 15ULL * 1000000000ULL) {
+			printf("\nnio: the matching path has made no progress for 15 seconds (rounds=%u)",
+			    nio_match_progress);
+			panic("nio: the matching path stalled (rounds=%u)", nio_match_progress);
+		}
+	}
+}
+
