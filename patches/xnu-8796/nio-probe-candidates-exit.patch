Mark the return from probeCandidates

M34 is the last thing on the panel and the entry counter cannot say whether that
call returned.  One line at the function's single exit settles it.
---
diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 6d7dd7e..8cbe5a8 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -4201,6 +4201,14 @@ IOService::probeCandidates( OSOrderedSet * matches )
 	if (startDict) {
 		startDict->release();
 	}
+	/* nio: the entry counter said M34 and nothing after it, but that counter
+	 * cannot tell a call that is still inside from one that returned and was
+	 * never followed by another.  Print on the way out too; the pair closes
+	 * the function the same way start>/load> close theirs. */
+	{
+		static uint32_t nio_pc_exit;
+		printf("\nmx%u", ++nio_pc_exit);
+	}
 }
 
