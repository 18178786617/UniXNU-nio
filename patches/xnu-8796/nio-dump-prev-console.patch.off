Print the previous boot's console tail out of ramoops

The panel is a forty-line overwrite buffer that is never cleared, so a photo
cannot show a log that scrolled off, and line numbers in a photo cannot be
ordered against the current boot.  The kernel already mirrors every console
character into the pstore console record at 0xAF040000 (see
nio-console-to-ramoops.patch): { u32 sig 'DBGC', u32 off, u32 off } followed
by a 0x3F000 byte ring.  DarwinBoot does not print that record.

Each boot starts writing at ring offset zero again, so only the first few
hundred bytes of the previous log are overwritten; the rest of it is still
there.  Console output is printable text, so a run of 64 zero bytes marks the
end of everything ever written.  Snapshot the last twelve non-empty lines
before that boundary, then print them -- printing itself appends to the same
ring, which is why the snapshot is taken before any output is produced.

Called once from kernel_bootstrap(), right after the version line: by then the
console works, and this is before vm_mem_bootstrap() and the startup table, so
the previous tail is on screen even if this boot dies early.  One short line
plus at most twelve short lines; no per-entry tracing, no high-rate probes.
The end/rows numbers in that first line say how much data was actually there,
so a truncated or stale record cannot be mistaken for a real log.
---
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index a7f1a44..782f576 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -458,6 +458,93 @@ kernel_startup_initialize_upto(startup_subsystem_id_t upto)
 	startup_phase = upto;
 }
 
+/*
+ * nio: print the tail of the previous boot's console log out of the pstore
+ * console ring.  The panel is a forty-line overwrite buffer that is never
+ * cleared, so anything that scrolled off cannot be read from a photo.
+ *
+ * This boot starts writing at offset zero again.  Only the first few hundred
+ * bytes of the previous log are lost; everything up to the first long run of
+ * zero bytes is still console text.  Copy out the last twelve lines before
+ * printing, because printing appends to the same ring.
+ */
+#define NIO_PREV_HDR    0xAF040000ULL
+#define NIO_PREV_SIZE   0x3F000UL
+#define NIO_PREV_ROWS   12
+#define NIO_PREV_COLS   72
+#define NIO_PREV_ZEROS  64
+
+static void
+nio_dump_prev_console(void)
+{
+    volatile uint32_t *hdr = (volatile uint32_t *)(uintptr_t)NIO_PREV_HDR;
+    volatile char *ring = (volatile char *)(uintptr_t)(NIO_PREV_HDR + 12);
+    static char lines[NIO_PREV_ROWS][NIO_PREV_COLS];
+    unsigned long i, end = 0;
+    unsigned int zeros;
+    int rows = 0, skip, seen = 0, row = 0, col = 0;
+
+    if (hdr[0] != 0x43474244u) {
+        return;
+    }
+
+    zeros = 0;
+    for (i = 0; i < NIO_PREV_SIZE; i++) {
+        char c = ring[i];
+
+        if (c == 0) {
+            if (++zeros >= NIO_PREV_ZEROS) {
+                break;
+            }
+        } else {
+            zeros = 0;
+        }
+        end = i + 1;
+        if (c == '\n') {
+            if (col > 0) {
+                rows++;
+                col = 0;
+            }
+        } else if (c >= 32 && c < 127) {
+            col++;
+        }
+    }
+    skip = rows > NIO_PREV_ROWS ? rows - NIO_PREV_ROWS : 0;
+
+    zeros = 0;
+    for (i = 0; i < NIO_PREV_SIZE; i++) {
+        char c = ring[i];
+
+        if (c == 0) {
+            if (++zeros >= NIO_PREV_ZEROS) {
+                break;
+            }
+        } else {
+            zeros = 0;
+        }
+        if (c == '\n') {
+            if (col > 0) {
+                if (seen >= skip && row < NIO_PREV_ROWS) {
+                    lines[row][col < NIO_PREV_COLS ? col : NIO_PREV_COLS - 1] = 0;
+                    row++;
+                }
+                seen++;
+                col = 0;
+            }
+        } else if (c >= 32 && c < 127) {
+            if (seen >= skip && row < NIO_PREV_ROWS && col < NIO_PREV_COLS - 1) {
+                lines[row][col] = c;
+            }
+            col++;
+        }
+    }
+
+    printf("\nP: prev console end=%lu rows=%d\n", end, rows);
+    for (i = 0; i < (unsigned long)row; i++) {
+        printf("%s\n", lines[i]);
+    }
+}
+
 void
 kernel_bootstrap(void)
 {
@@ -466,6 +553,7 @@ kernel_bootstrap(void)
 	char            namep[16];
 
 	printf("%s\n", version); /* log kernel version */
+	nio_dump_prev_console();
 
 	scale_setup();
 
