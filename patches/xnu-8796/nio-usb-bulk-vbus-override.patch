nio: restore the VBUS override so the host sees the bulk gadget

Run 664 rebuilt the gadget from sweet 0072+0073 only, dropping 0074's
QSCRATCH VBUS override.  Without a forced VBUS session the controller
never pulls D+ up, so the PC sees no USB device at all (60 s monitor of
VID_1209/VID_0000/VID_22B8 was completely empty).  Bring the override
back: QSCRATCH registers and the VBUS force right before RUN_STOP.

diff --git a/bsd/dev/nio_usb.c b/bsd/dev/nio_usb.c
index 5960a32..223055e 100644
--- a/bsd/dev/nio_usb.c
+++ b/bsd/dev/nio_usb.c
@@ -145,6 +145,16 @@ nio_usb_gadget_probe(void)
 #define DEPCMDPAR0(n)   (0xc808 + 0x10 * (n))
 #define DEPCMD(n)       (0xc80c + 0x10 * (n))
 
+/* Qualcomm wrapper QSCRATCH (core base + 0xf8800): force a VBUS
+ * session so the controller pulls D+ up and the host sees us.
+ * (sweet 0074; omitted when the bulk driver was rebuilt -- fixed in 665) */
+#define QSCRATCH_PA             0x0a6f8800
+#define QSCRATCH_HS_PHY_CTRL    0x10
+#define   UTMI_OTG_VBUS_VALID   (1u << 20)
+#define   SW_SESSVLD_SEL        (1u << 28)
+#define QSCRATCH_SS_PHY_CTRL    0x30
+#define   LANE0_PWR_PRESENT     (1u << 24)
+
 #define DCTL_RUN_STOP   (1u << 31)
 #define DCTL_CSFTRST    (1u << 30)
 #define DSTS_DEVCTRLHLT (1u << 22)
@@ -538,6 +548,15 @@ nio_usb_gadget_start(vm_offset_t dwc)
 	}
 	dwc_wr(DALEPENA, 0x9);   /* EP0 + EP1 IN bulk */
 	ud_start_setup();
+	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+	if (qs != 0) {
+		uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL), ss = usb_rd(qs, QSCRATCH_SS_PHY_CTRL);
+		printf("nio: USB: QSCRATCH HS 0x%08x SS 0x%08x\n", hs, ss);
+		*(volatile uint32_t *)(qs + QSCRATCH_HS_PHY_CTRL) = hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
+		*(volatile uint32_t *)(qs + QSCRATCH_SS_PHY_CTRL) = ss | LANE0_PWR_PRESENT;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("nio: USB: VBUS override on\n");
+	}
 
 	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
 	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
