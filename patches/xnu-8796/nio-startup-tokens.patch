Print the address of every startup entry so the last one resolves to a function
---
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index bec97fb..8f13a6f 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -407,6 +407,16 @@ kernel_startup_initialize_upto(startup_subsystem_id_t upto)
 		}
 		startup_phase = cur->subsystem - 1;
 		kernel_startup_log(cur->subsystem);
+		/*
+		 * nio: number and address of every startup entry, printed before it
+		 * runs.  The last line on the glass is the entry that did not return,
+		 * and its address resolves to a function with kernel-symbols.py.
+		 */
+		if (cur->subsystem >= STARTUP_SUB_KPRINTF) {
+			static uint32_t nio_entry_no;
+			printf("\n[#%u:%llx]", ++nio_entry_no,
+			    (unsigned long long)(uintptr_t)cur->func);
+		}
 		cur->func(cur->arg);
 		startup_entry_cur = ++cur;
 	}
