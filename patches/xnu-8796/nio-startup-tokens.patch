Print every eighth startup entry with its address
---
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index bec97fb..c25e3e7 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -407,6 +407,23 @@ kernel_startup_initialize_upto(startup_subsystem_id_t upto)
 		}
 		startup_phase = cur->subsystem - 1;
 		kernel_startup_log(cur->subsystem);
+		/*
+		 * nio: only every eighth entry prints, because the panel keeps forty
+		 * lines and a token per entry buries itself.  The address is printed
+		 * whole, and the argument with it: masking the address to 28 bits made
+		 * a kernel entry indistinguishable from a prelinked kext one, and the
+		 * argument is unique per entry, so the pair names the entry that does
+		 * not return even when the symbol table has no name for its function.
+		 */
+		if (cur->subsystem >= STARTUP_SUB_KPRINTF) {
+			static uint32_t nio_entry_no;
+			uint32_t nio_this = ++nio_entry_no;
+			if ((nio_this & 7u) == 0u) {
+				printf("\n[#%u:%llx:%llx]", nio_this,
+				    (unsigned long long)(uintptr_t)cur->func,
+				    (unsigned long long)(uintptr_t)cur->arg & 0xfffffffu);
+			}
+		}
 		cur->func(cur->arg);
 		startup_entry_cur = ++cur;
 	}
