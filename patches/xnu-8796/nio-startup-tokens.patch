Print only the late startup entries and mark the end of the table
---
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index bec97fb..fba4ae1 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -407,10 +407,21 @@ kernel_startup_initialize_upto(startup_subsystem_id_t upto)
 		}
 		startup_phase = cur->subsystem - 1;
 		kernel_startup_log(cur->subsystem);
+		/*
+		 * nio: only the late subsystems print, so the list stays ordered and fits
+		 * on the forty line panel.  The last line is the entry that did not
+		 * return; its address resolves with tools/kernel-symbols.py.
+		 */
+		if (cur->subsystem >= STARTUP_SUB_MACH_IPC &&
+		    cur->subsystem != STARTUP_SUB_LOCKDOWN) {
+			printf("\n[%u.%d:%llx]", cur->subsystem, (int)cur->rank,
+			    (unsigned long long)(uintptr_t)cur->func);
+		}
 		cur->func(cur->arg);
 		startup_entry_cur = ++cur;
 	}
 	kernel_startup_log(upto);
+	printf("\n[STARTUP-END %u]\n", (unsigned)upto);
 
 	if ((startup_debug & STARTUP_DEBUG_VERBOSE) &&
 	    upto >= STARTUP_SUB_KPRINTF) {
