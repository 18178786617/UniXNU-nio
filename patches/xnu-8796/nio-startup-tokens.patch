Number the startup tokens so one entry can be told from another
---
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index bec97fb..841b5ca 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -407,6 +407,15 @@ kernel_startup_initialize_upto(startup_subsystem_id_t upto)
 		}
 		startup_phase = cur->subsystem - 1;
 		kernel_startup_log(cur->subsystem);
+		/*
+		 * nio: one short token per startup entry, before it runs.  Many entries
+		 * share subsystem and rank, so carry a running number as well: the last
+		 * token on the glass then names exactly which entry did not return.
+		 */
+		if (cur->subsystem >= STARTUP_SUB_KPRINTF) {
+			static uint32_t nio_entry_no;
+			printf("\n[%d.%d#%u]", cur->subsystem, cur->rank, ++nio_entry_no);
+		}
 		cur->func(cur->arg);
 		startup_entry_cur = ++cur;
 	}
