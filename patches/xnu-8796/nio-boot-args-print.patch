Save topOfKernelData in a global

The panic path needs the loader's topOfKernelData but PE_state is awkward in
that translation unit, so save it once at machine_startup.
---
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index e76e7e7..3355934 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -475,8 +475,13 @@ machine_startup(__unused boot_args * args)
 #endif /* defined(HAS_IPI) && (DEVELOPMENT || DEBUG)*/
 
 
+	uint64_t nio_kdata_saved = 0;
+
 	machine_conf();
 
+	if (PE_state.bootArgs != NULL) {
+		nio_kdata_saved = PE_state.bootArgs->topOfKernelData;
+	}
 
 	/*
 	 * Kick off the kernel bootstrap.
