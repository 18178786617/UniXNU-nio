Save topOfKernelData in a file scope global

The first attempt declared it inside machine_startup, so sleh.c's extern never
resolved.  Declare it at file scope and assign at startup.
---
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index e76e7e7..bf2a8e1 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -465,6 +465,8 @@ user_timebase_type(void)
 #endif
 }
 
+uint64_t nio_kdata_saved = 0;
+
 void
 machine_startup(__unused boot_args * args)
 {
@@ -475,6 +477,10 @@ machine_startup(__unused boot_args * args)
 #endif /* defined(HAS_IPI) && (DEVELOPMENT || DEBUG)*/
 
 
+	if (PE_state.bootArgs != NULL) {
+		nio_kdata_saved = PE_state.bootArgs->topOfKernelData;
+	}
+
 	machine_conf();
 
 
