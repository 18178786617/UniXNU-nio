Print the boot_args the loader handed over

The boot stack sits at 0xfffffff007bc7f90, inside the kernel text/data window, and
the first push into it is a permission fault.  XNU derives the physmap and the
boot stack position from boot_args->topOfKernelData, so print virtBase, physBase,
memSize, topOfKernelData and the live sp once the console is up.
---
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index e76e7e7..5b1af35 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -477,6 +477,18 @@ machine_startup(__unused boot_args * args)
 
 	machine_conf();
 
+	{
+		volatile uint64_t nio_marker = 0;
+		boot_args *nio_ba = PE_state.bootArgs;
+		if (nio_ba != NULL) {
+			printf("nio: ba virt %lx phys %lx size %lx kdata %lx sp %lx\n",
+			    (unsigned long)nio_ba->virtBase,
+			    (unsigned long)nio_ba->physBase,
+			    (unsigned long)nio_ba->memSize,
+			    (unsigned long)nio_ba->topOfKernelData,
+			    (unsigned long)(uintptr_t)&nio_marker);
+		}
+	}
 
 	/*
 	 * Kick off the kernel bootstrap.
