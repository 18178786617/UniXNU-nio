nio: move UB01 EL0-entry mark into the reliably compiled sched_prim.c

The linked kern_exec.o carried only a random subset of the exec marks in
rounds 698-705 (D06/D12/D13/C02 but never UB01/M02/D07), although the source
had all of them.  UB01 is the only mark that answers whether the new exec
thread reaches thread_bootstrap_return (EL0 entry) -- the last untested gate
between here and the iOS userland.  Its C definition lived in kern_exec.c,
so it never reached the core.  Move the definition to sched_prim.c, whose
SEL/HB marks reach every panel, using the same cons_ops writer; locore.s's
bl EXT(nio_bootmark) is unchanged.  Nothing else changes.

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -1205,12 +1205,6 @@
 	}
 }
 
-/* nio: B2 -- called from thread_bootstrap_return (EL0 entry, asm). */
-void
-nio_bootmark(void)
-{
-	nio_emark("\nnio: UB01 bootret");
-}
 
 static int
 exec_mach_imgact(struct image_params *imgp)

diff --git a/osfmk/kern/sched_prim.c b/osfmk/kern/sched_prim.c
--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -398,6 +398,17 @@
 	while (*s != '\0') { cons_ops[1].putc(*s++, true); }
 }
 
+/* nio: UB01 -- EL0 entry probe, called from thread_bootstrap_return (locore.s).
+ * Defined here, not in kern_exec.c: that file's marks reached the linked core
+ * only as a random subset in rounds 698-705, so UB01 (the one mark that would
+ * tell whether the new exec thread ever returns to userland) never appeared.
+ * sched_prim.c is compiled reliably -- its SEL/HB marks are on every panel. */
+void nio_bootmark(void)
+{
+	const char *s = "\nnio: UB01 bootret";
+	while (*s != '\0') { cons_ops[1].putc(*s++, true); }
+}
+
 /* nio: print one hex digit, lock-free (for idle_reason, 0..9). */
 static void __attribute__((noinline))
 nio_sel_hex1(unsigned int v)
