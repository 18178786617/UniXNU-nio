+extern volatile unsigned int nio_match_rounds;
 
 /* nio: a beacon that never sleeps.  The heartbeat thread below uses delay(),
  * which needs working timers; it prints HB 1 and stops, and that tells us
@@ -550,7 +551,15 @@ nio_beacon_thread(void *arg, wait_result_t wr)
 		n++;
 		if ((n % 2000000ul) == 0) {
 			nio_dc_puts("V");
-			nio_dc_putu(++mark);
+			/* nio: the number beside the letter changes so fast that
+			 * a photograph cannot say whether the matching is moving:
+			 * it was a different number every time the shutter opened.
+			 * The letter keeps its beat; the number is written every
+			 * sixteenth time, so a photograph says how far it has come.
+			 */
+			if ((mark & 0xfu) == 0) {
+				nio_dc_putu(mark);
+			}
 			nio_dc_puts(" ");
 			/* nio: where the boot thread and the matching thread are.
 			 *
@@ -564,6 +573,8 @@ nio_beacon_thread(void *arg, wait_result_t wr)
 				nio_dc_putu((unsigned)nio_match_waypoint);
 				nio_dc_puts("c");
 				nio_dc_putu(nio_cand_count);
+				nio_dc_puts("q");
+				nio_dc_putu(nio_match_rounds);
 				nio_dc_puts("r");
 				nio_dc_putu(nio_cand_reason);
 				nio_dc_puts("d");
