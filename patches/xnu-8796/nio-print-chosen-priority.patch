nio: print the priority of the thread chosen instead of PID1

Run 688 showed thread_select always picks OTHER, never PID1.  Print the
chosen thread's sched_pri (two hex digits) next to each OTHER line so a
single photo tells whether a high-priority kernel thread is starving PID1
(base/sched_pri 31/25).  PID1 itself has sched_pri ~0x19.

diff --git a/osfmk/kern/sched_prim.c b/osfmk/kern/sched_prim.c
index ee7208e..b4888b9 100644
--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -2826,8 +2826,14 @@ send_followup_ipi_before_idle:
 
 		/* No RT threads, so let's look at the regular threads. */
 		if ((new_thread = SCHED(choose_thread)(processor, MINPRI, *reason)) != THREAD_NULL) {
-			nio_sel_puts(new_thread == nio_pid1_thread ?
-			    "\nnio: SEL chose PID1" : "\nnio: SEL chose OTHER");
+			if (new_thread == nio_pid1_thread) {
+				nio_sel_puts("\nnio: SEL chose PID1");
+			} else {
+				unsigned int op = (unsigned int)new_thread->sched_pri;
+				nio_sel_puts("\nnio: SEL OTHER pri=");
+				nio_sel_hex1(op >> 4);
+				nio_sel_hex1(op & 0xf);
+			}
 			pset_commit_processor_to_new_thread(pset, processor, new_thread);
 
 			clear_pending_AST_bits(pset, processor, 4);
