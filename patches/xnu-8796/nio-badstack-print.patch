Carry topOfKernelData in the stack panic

The boot_args print scrolled off the 40 line console before the panic.  Put sp,
kernel_stack, kstackptr, topOfKernelData and virtBase in the panic string, which
is the last thing on screen.
---
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 2cc442e..ca31243 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -2087,6 +2087,10 @@ sleh_invalid_stack(arm_context_t *context, uint32_t esr __unused, vm_offset_t fa
 		panic_with_thread_kernel_state("Invalid kernel stack pointer (probable overflow).", &context->ss);
 	}
 
-	panic_with_thread_kernel_state("Invalid kernel stack pointer (probable corruption).", &context->ss);
+	panic("BadStk sp %lx kstk %lx top %lx kdata %lx virt %lx",
+	    (unsigned long)sp, (unsigned long)thread->kernel_stack,
+	    (unsigned long)thread->machine.kstackptr,
+	    (unsigned long)(PE_state.bootArgs ? PE_state.bootArgs->topOfKernelData : 0),
+	    (unsigned long)(PE_state.bootArgs ? PE_state.bootArgs->virtBase : 0));
 }
 
