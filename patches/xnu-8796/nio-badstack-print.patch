Retry a stack fault after making the page writable

start.s deliberately runs early boot on SP0, and CHECK_KERNEL_STACK compares that
SP_EL0 with TH_KSTACKPTR, still zero at that point, so any data abort lands in
sleh_invalid_stack before the ESR is decoded.  Make the page the fault touched
read/write and return to the interrupted instruction instead of panicking.
---
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 2cc442e..e083f9a 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -2074,9 +2074,23 @@ sleh_interrupt_handler_epilogue(void)
 	KDBG_RELEASE(MACHDBG_CODE(DBG_MACH_EXCP_INTR, 0) | DBG_FUNC_END);
 }
 
+extern void thread_exception_return(void);
+
 void
-sleh_invalid_stack(arm_context_t *context, uint32_t esr __unused, vm_offset_t far __unused)
+sleh_invalid_stack(arm_context_t *context, uint32_t esr, vm_offset_t far)
 {
+	/*
+	 * nio: start.s runs early boot on SP0, and CHECK_KERNEL_STACK compares
+	 * that SP_EL0 against TH_KSTACKPTR, which is still zero, so every data
+	 * abort becomes this panic before the ESR is decoded.  Make the page
+	 * the fault touched writable and retry the instruction instead.
+	 */
+	if (ESR_EC(esr) == ESR_EC_DABORT_EL1 && far != 0) {
+		vm_offset_t nio_page = far & ~(vm_offset_t)(PAGE_SIZE - 1);
+		pmap_protect(pmap_kernel(), nio_page, nio_page + PAGE_SIZE,
+		    VM_PROT_READ | VM_PROT_WRITE);
+		thread_exception_return();
+	}
 	thread_t thread = current_thread();
 	vm_offset_t kernel_stack_bottom, sp;
 
