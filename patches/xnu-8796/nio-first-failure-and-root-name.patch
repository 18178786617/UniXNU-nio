+volatile unsigned int nio_first_fail = 0;
+char nio_first_want[24] = "-";
+char nio_first_have[24] = "-";
+char nio_root_name[32] = "-";
 
 /* nio: a beacon that never sleeps.  The heartbeat thread below uses delay(),
  * which needs working timers; it prints HB 1 and stops, and that tells us
@@ -567,14 +571,16 @@ nio_beacon_thread(void *arg, wait_result_t wr)
 				nio_dc_puts(nio_cand_class);
 				if (nio_match_fail) {
 					nio_dc_puts("x");
-					nio_dc_putu(nio_match_fail);
+					nio_dc_putu(nio_first_fail);
 					nio_dc_puts(" ");
-					nio_dc_puts(nio_match_want);
+					nio_dc_puts(nio_first_want);
 					nio_dc_puts("|");
-					nio_dc_puts(nio_match_have);
+					nio_dc_puts(nio_first_have);
 				}
 				nio_dc_puts(" f");
 				nio_dc_puts(nio_first_class);
+				nio_dc_puts(" N");
+				nio_dc_puts(nio_root_name);
