Keep the console log in ramoops and remember where it ended

The panel renderer stops drawing glyphs late in the boot: the line stamp in the
right margin keeps counting (9962 in the last video) while the rows below stay
blank, so the last readable line is no longer the last line printed.

The recorder already copied every character into the pstore record but reset the
ring at each boot, which loses the one thing worth having -- where the previous
boot stopped; the ring wraps several times before the boot dies, so its end is
not the newest text.

Retire the previous offset into a tag word at the end of the ring on the first
character of a boot.  The next boot then reads the last kilobyte before that
offset and knows it is the tail of a finished boot, not a guess.
---
diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index e5b23f2..707baa3 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -593,6 +593,60 @@ console_write_unbuffered(char c)
 	_cnputc(c, true);
 }
 
+/*
+ * nio: keep this boot's console log in the ramoops record at 0xAF040000 so the
+ * next boot can show how this one ended.
+ *
+ *   [0] sig 'DBGC'   [1] write offset   [2] same as [1]
+ *   [3 ..] ring, NIO_RAMOOPS_RING bytes
+ *   ring end - 8: tag '1NIO', then the previous boot's final write offset
+ *
+ * The panel renderer stops drawing glyphs late in the boot -- the line stamp in
+ * the right margin keeps counting while the rows stay blank -- so the record is
+ * the only copy of the text that survives.  Its tag word is what lets the next
+ * boot find the exact place this one stopped instead of guessing inside a ring
+ * that has wrapped several times.
+ *
+ * 0xAF040000 is a physical address, and this port maps it: the recorder has
+ * written here for every console character since the first ramoops round
+ * without a fault, so no translation is applied here either.
+ */
+#define NIO_RAMOOPS_BASE 0xAF040000ull
+#define NIO_RAMOOPS_RING 0x3F000u
+#define NIO_RAMOOPS_SIG  0x43474244u    /* 'DBGC' */
+#define NIO_RAMOOPS_TAG  0x4F494E31u    /* '1NIO' */
+
+static void
+nio_ramoops_putc(char c)
+{
+	volatile u32  *hdr  = (volatile u32 *)(uintptr_t)NIO_RAMOOPS_BASE;
+	volatile char *ring = (volatile char *)(uintptr_t)(NIO_RAMOOPS_BASE + 12);
+	volatile u32  *tag  = (volatile u32 *)(uintptr_t)(NIO_RAMOOPS_BASE + 12 +
+	                        NIO_RAMOOPS_RING - 8);
+	u32 off;
+
+	if (tag[0] != NIO_RAMOOPS_TAG) {
+		/* First character of this boot: retire the previous offset. */
+		u32 prev = (hdr[0] == NIO_RAMOOPS_SIG) ? hdr[1] : 0;
+
+		if (prev > NIO_RAMOOPS_RING - 8) {
+			prev = 0;
+		}
+		hdr[0] = NIO_RAMOOPS_SIG;
+		hdr[1] = 0;
+		hdr[2] = 0;
+		tag[0] = NIO_RAMOOPS_TAG;
+		tag[1] = prev;
+	}
+	off = hdr[1];
+	if (off >= NIO_RAMOOPS_RING - 8) {
+		off = 0;
+	}
+	ring[off] = c;
+	hdr[1] = off + 1;
+	hdr[2] = off + 1;
+}
+
 /**
  * Write a single character to the selected console (video or serial).
  *
@@ -601,6 +655,7 @@ console_write_unbuffered(char c)
 void
 console_write_char(char c)
 {
+	nio_ramoops_putc(c);
 	console_write(&c, 1);
 }
 
