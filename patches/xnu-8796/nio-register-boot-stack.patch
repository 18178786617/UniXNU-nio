Register the boot stack above the live frame

The registration worked: the panic moved from corruption to overflow, meaning
sp now falls just below the recorded bottom.  Record the top 128 KiB above the
live frame instead of one page, and protect that whole window, so the boot
thread's deepest frame stays inside it.
---
diff --git a/osfmk/kern/stack.c b/osfmk/kern/stack.c
index ce42b1a..df4970d 100644
--- a/osfmk/kern/stack.c
+++ b/osfmk/kern/stack.c
@@ -127,6 +127,27 @@ stack_init(void)
 
 	stack_addr_mask = roundup_pow2(kernel_stack_size) - 1;
 	kernel_stack_mask = ~stack_addr_mask;
+
+	/*
+	 * nio: the boot stack is the loader's and nothing registers it.  Put the
+	 * recorded top 128 KiB above the live frame so the check's bottom sits
+	 * well above the deepest frame the boot thread will reach, and make the
+	 * whole window writable now that pmap_kernel() is the live map.
+	 */
+	{
+		thread_t nio_th = current_thread();
+		volatile uint64_t nio_marker = 0;
+		uint64_t nio_sp = (uint64_t)(uintptr_t)&nio_marker;
+		uint64_t nio_page = nio_sp & ~(uint64_t)0x3fffull;
+		uint64_t nio_top = nio_page + 0x20000ull;
+		if (nio_th != THREAD_NULL && nio_th->machine.kstackptr == 0) {
+			nio_th->machine.kstackptr = (vm_offset_t)nio_top;
+			nio_th->kernel_stack = (vm_offset_t)(nio_top - kernel_stack_size);
+		}
+		pmap_protect(pmap_kernel(), (vm_offset_t)(nio_page - 0x100000ull),
+		    (vm_offset_t)(nio_top + 0x4000ull),
+		    VM_PROT_READ | VM_PROT_WRITE);
+	}
 }
 STARTUP(TUNABLES, STARTUP_RANK_MIDDLE, stack_init);
 
