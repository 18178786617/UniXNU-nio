@@ -512,6 +512,23 @@ volatile unsigned int nio_cand_reason = 0;
 volatile unsigned int nio_drop_reason = 0;
 char nio_cand_class[32] = "?";
 
+/* nio: which check of the passive match said no.
+ *
+ * The candidates are turned away by the passive match -- the one that
+ * asks whether the nub is the thing the personality wants.  It asks
+ * in four places: the name, the location, the properties and the
+ * existence of a property.  Which of them said no is the difference
+ * between a personality that wanted another board and one that wanted
+ * this one and was asked for the wrong name.
+ *
+ * x is the number of the check that said no (0 is none, 4 the name,
+ * 5 the location, 6 the properties, 7 the existence of a property),
+ * and after it what was wanted and what the nub is called.
+ */
+volatile unsigned int nio_match_fail = 0;
+char nio_match_want[24] = "-";
+char nio_match_have[24] = "-";
+
 /* nio: a beacon that never sleeps.  The heartbeat thread below uses delay(),
  * which needs working timers; it prints HB 1 and stops, and that tells us
  * nothing about whether the kernel is alive.  This one spins on its own and
@@ -546,6 +563,14 @@ nio_beacon_thread(void *arg, wait_result_t wr)
 				nio_dc_putu(nio_drop_reason);
 				nio_dc_puts(" ");
 				nio_dc_puts(nio_cand_class);
+				if (nio_match_fail) {
+					nio_dc_puts("x");
+					nio_dc_putu(nio_match_fail);
+					nio_dc_puts(" ");
+					nio_dc_puts(nio_match_want);
+					nio_dc_puts("|");
+					nio_dc_puts(nio_match_have);
+				}
 				nio_dc_puts(" ");
 			}
 		}
