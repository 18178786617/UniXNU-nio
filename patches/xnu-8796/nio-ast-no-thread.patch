Skip the AST path until the thread has a task

run-132 still faults at get_threadtask+0x28 with far 0, so the thread pointer is
fine and it is thread->task that is NULL: nothing has attached a task yet.
Return before the AST path dereferences it.
---
diff --git a/osfmk/kern/ast.c b/osfmk/kern/ast.c
index ba26da2..38610cd 100644
--- a/osfmk/kern/ast.c
+++ b/osfmk/kern/ast.c
@@ -158,8 +158,19 @@ ast_taken_user(void)
 {
 	assert(ml_get_interrupts_enabled() == FALSE);
 
+	/*
+	 * nio: early in boot the thread exists but thread->task does not, so
+	 * get_threadtask hands back NULL and the AST path dereferences zero.
+	 * Nothing to do until the task is attached.
+	 */
 	thread_t thread = current_thread();
+	if (thread == NULL) {
+		return;
+	}
 	task_t   task   = get_threadtask(thread);
+	if (task == NULL) {
+		return;
+	}
 
 	/* We are about to return to userspace, there must not be a pending wait */
 	assert(waitq_wait_possible(thread));
