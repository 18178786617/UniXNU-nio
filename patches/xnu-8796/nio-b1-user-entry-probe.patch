nio: B1 -- report the exec'd thread's EL0 entry state

696 reached execve ret=0 but no "IPROBE:" line ever appeared: the kernel
side of exec completed, yet the user-space main never ran.  Print the new
thread's user registers right after the successful proc_exec_switch_task:
U01 saved-state pointer, U02 EL0 entry PC, U03 user SP, U04 CPSR (or U05
if no user state).  Expected initprobe entry is 0x100000000-based; if
PC/SP match, exec set things up and the fault is after ERET to EL0.

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 28bee6a..8ed9367 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -1190,6 +1190,18 @@ nio_ehex(unsigned v)
 	}
 }
 
+/* nio: 64-bit hex for user-space entry addresses. */
+static void
+nio_ehex64(unsigned long long v)
+{
+	int i;
+	const char *d = "0123456789abcdef";
+
+	for (i = 60; i >= 0; i -= 4) {
+		cons_ops[1].putc(d[(v >> i) & 0xf], true);
+	}
+}
+
 static int
 exec_mach_imgact(struct image_params *imgp)
 {
@@ -5108,6 +5120,23 @@ __mac_execve(proc_t p, struct __mac_execve_args *uap, int32_t *retval __unused)
 	if (!error) {
 		p = proc_exec_switch_task(current_proc(), p, old_task, new_task, imgp->ip_new_thread, &inherit);
 		nio_emark("\nnio: E05 switched");
+		/* nio: B1 -- is the exec'd thread's EL0 entry set correctly? */
+		{
+			struct savearea *nio_us_raw = get_user_regs(imgp->ip_new_thread);
+			arm_saved_state_t *nio_us = (arm_saved_state_t *)nio_us_raw;
+			nio_emark("\nnio: U01 user regs=");
+			nio_ehex64((unsigned long long)(uintptr_t)nio_us);
+			if (nio_us != NULL) {
+			nio_emark("\nnio: U02 user pc=");
+				nio_ehex64((unsigned long long)saved_state64(nio_us)->pc);
+			nio_emark("\nnio: U03 user sp=");
+				nio_ehex64((unsigned long long)saved_state64(nio_us)->sp);
+			nio_emark("\nnio: U04 user cpsr=");
+				nio_ehex((unsigned)saved_state64(nio_us)->cpsr);
+			} else {
+			nio_emark("\nnio: U05 NO user regs");
+			}
+		}
 		/* proc ref returned */
 		should_release_proc_ref = TRUE;
 	}
