Do not wait forever for the dlil threads, and say why they never ran

bsd_init stops in dlil_init: the last line on the panel is the 'Waiting for all
the create dlil kernel threads to get scheduled' one.  That loop sleeps on
dlil_pending_thread_cnt with a NULL timeout, so if either thread never runs,
bsd_init never returns and nothing after it -- bsd_autoconf, the launchd handoff
-- is reached.

Wait at most five one-second slices, then print what is still pending along with
both thread pointers and carry on.  Also keep the return value of
dlil_create_input_thread(): it used to be discarded, and a failure there leaves
the count at 1 with no thread able to clear it, which is the same hang.
---
diff --git a/bsd/net/dlil.c b/bsd/net/dlil.c
index 78791d9..9e683da 100644
--- a/bsd/net/dlil.c
+++ b/bsd/net/dlil.c
@@ -2678,7 +2678,17 @@ dlil_init(void)
 	 * detacher threads once everything is initialized.
 	 */
 	dlil_incr_pending_thread_count();
-	(void) dlil_create_input_thread(NULL, dlil_main_input_thread, NULL);
+	{
+		/* nio: the return value was ignored, and a failure here leaves the
+		 * pending count at 1 with no thread to clear it, so the wait below can
+		 * never end.  Keep it and print it. */
+		int nio_in_err = dlil_create_input_thread(NULL,
+		    dlil_main_input_thread, NULL);
+
+		if (nio_in_err != 0) {
+			printf("nio: dlil input thread not created: %d\n", nio_in_err);
+		}
+	}
 
 	/*
 	 * Create ifnet detacher thread.
@@ -2700,12 +2710,34 @@ dlil_init(void)
 	 * scheduled and run at least once before we proceed
 	 */
 	lck_mtx_lock(&dlil_thread_sync_lock);
-	while (dlil_pending_thread_cnt != 0) {
-		DLIL_PRINTF("%s: Waiting for all the create dlil kernel "
-		    "threads to get scheduled at least once.\n", __func__);
-		(void) msleep(&dlil_pending_thread_cnt, &dlil_thread_sync_lock,
-		    (PZERO - 1), __func__, NULL);
-		LCK_MTX_ASSERT(&dlil_thread_sync_lock, LCK_ASSERT_OWNED);
+	{
+		/*
+		 * nio: this wait has no timeout, so a thread that never gets scheduled
+		 * holds bsd_init for good -- which is where the boot stopped, with the
+		 * "Waiting for all the create dlil kernel threads" line as the last
+		 * thing on the panel.  Wait a bounded number of one-second slices,
+		 * report what is still pending and carry on: the rest of the network
+		 * stack is not what the launchd handoff needs.
+		 */
+		int nio_wait = 0;
+		int nio_ts = 100;
+
+		while (dlil_pending_thread_cnt != 0 && nio_wait < 5) {
+			DLIL_PRINTF("%s: Waiting for all the create dlil kernel "
+			    "threads to get scheduled at least once.\n", __func__);
+			(void) msleep(&dlil_pending_thread_cnt, &dlil_thread_sync_lock,
+			    (PZERO - 1), __func__, &nio_ts);
+			LCK_MTX_ASSERT(&dlil_thread_sync_lock, LCK_ASSERT_OWNED);
+			nio_wait++;
+			nio_ts = 100;
+		}
+		if (dlil_pending_thread_cnt != 0) {
+			printf("nio: dlil threads never ran, %d still pending "
+			    "(input %p, detacher %p), carrying on\n",
+			    dlil_pending_thread_cnt,
+			    (void *)dlil_main_input_thread->dlth_thread,
+			    (void *)thread);
+		}
 	}
 	lck_mtx_unlock(&dlil_thread_sync_lock);
 	DLIL_PRINTF("%s: All the created dlil kernel threads have been "
