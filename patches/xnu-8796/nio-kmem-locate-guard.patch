Count chunk failures inside one call and print a heartbeat while searching
---
diff --git a/osfmk/vm/vm_kern.c b/osfmk/vm/vm_kern.c
index 2927d4b..41bd176 100644
--- a/osfmk/vm/vm_kern.c
+++ b/osfmk/vm/vm_kern.c
@@ -3057,6 +3057,13 @@ kmem_locate_space(
 	vm_map_offset_t        *start_inout,
 	vm_map_entry_t         *entry_out)
 {
+	/*
+	 * nio: nio_retries counts consecutive chunk failures inside this call only;
+	 * a static counter at the again label counted every entry to the function
+	 * and panicked on the ninth ordinary allocation.  nio_spins only prints.
+	 */
+	uint32_t nio_retries = 0;
+	uint32_t nio_spins = 0;
 	vm_map_entry_t entry;
 	uint32_t size_idx = kmem_get_idx_from_size(size);
 	uint32_t front = kmem_get_front(range_id, from_right);
@@ -3065,6 +3072,9 @@ kmem_locate_space(
 
 	assert(size <= sizeclass->ks_size);
 again:
+	if (((++nio_spins) & 0xfffffu) == 0) {
+		printf(".");
+	}
 	if ((meta = LIST_FIRST(&sizeclass->ks_partial_head[front])) != NULL) {
 		*start_inout = kmem_get_addr_from_meta(meta, range_id, *sizeclass, &entry);
 		/*
@@ -3086,6 +3096,11 @@ again:
 	} else {
 		meta = kmem_get_new_chunk(range_id, from_right, size_idx);
 		if (meta == NULL) {
+			if (++nio_retries > 8u) {
+				printf("\nnio: kmem_locate_space stuck size=%#llx range=%d idx=%u\n",
+				    (unsigned long long)size, range_id, size_idx);
+				panic("nio: kmem_locate_space out of chunks");
+			}
 			goto again;
 		}
 		*start_inout = kmem_get_addr_from_meta(meta, range_id, *sizeclass, &entry);
