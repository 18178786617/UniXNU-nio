Stop the retry loop in kmem_locate_space after eight attempts

kmem_get_new_chunk() returning NULL jumps back to again with nothing changed, so an
exhausted range spins forever and the watchdog hides it.  Eight attempts is already
more than the working path needs, and printing at that point fits before the reset.
---
diff --git a/osfmk/vm/vm_kern.c b/osfmk/vm/vm_kern.c
index 2927d4b..6a6df69 100644
--- a/osfmk/vm/vm_kern.c
+++ b/osfmk/vm/vm_kern.c
@@ -3065,6 +3065,20 @@ kmem_locate_space(
 
 	assert(size <= sizeclass->ks_size);
 again:
+	{
+		/*
+		 * nio: kmem_get_new_chunk() returning NULL goes back to again with
+		 * nothing changed, so an exhausted range spins here forever.  The
+		 * legitimate path retries at most a handful of times, so say so
+		 * early enough to be seen before the watchdog fires.
+		 */
+		static uint32_t nio_chunk_retries;
+		if (++nio_chunk_retries > 8u) {
+			printf("\nnio: kmem_locate_space stuck size=%#llx range=%d idx=%u\n",
+			    (unsigned long long)size, range_id, size_idx);
+			panic("nio: kmem_locate_space out of chunks");
+		}
+	}
 	if ((meta = LIST_FIRST(&sizeclass->ks_partial_head[front])) != NULL) {
 		*start_inout = kmem_get_addr_from_meta(meta, range_id, *sizeclass, &entry);
 		/*
