Say what the device tree pointer points at

The whole storage path depends on one number that nothing has ever printed.
XNU does not read boot_args.deviceTreeP itself: PE_init_platform copies it
into PE_state.deviceTreeHead and hands it to SecureDTInit(), and every
device tree lookup afterwards -- the /arm-io children, the UFS host and PHY
nodes, /chosen/dram-base -- reads whatever SecureDTInit was given.

The boot arguments are not in the kernel image.  const_boot_args is all
zeroes in the file (verified in out/kernel.macho) and is filled at run time
from the structure the previous stage hands over in x0.  On this board that
previous stage is the stock Android bootloader, because the kernel is booted
with `fastboot boot`, and it has no reason to fill in an iOS device tree.
So the tree the kernel sees is whatever those bytes happen to be, which is
why /chosen/dram-base reads a different number on every boot and why the
UFS controller has never been matched: there is no node to match.

So print the pointer, the length, and whether the region holds a tree that
mentions the controller at all.  A pointer of zero, a length of zero, or a
region without "ufshc" in it says the same thing three different ways, and
the board's own tree does have that node -- out/nio.adt has /arm-io/ufs in
it, and the payload that carries it has "ufshc" in it too.

---


diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -400,6 +400,68 @@
 		PE_state.bootArgs = boot_args_ptr;
 		PE_state.deviceTreeHead = boot_args_ptr->deviceTreeP;
 		PE_state.deviceTreeSize = boot_args_ptr->deviceTreeLength;
+		/*
+		 * nio: say what the device tree pointer points at.
+		 *
+		 * The whole storage path depends on this one number, and nothing
+		 * has ever printed it.  XNU does not read boot_args.deviceTreeP
+		 * itself: PE_init_platform copies it into PE_state.deviceTreeHead
+		 * and hands it to SecureDTInit(), and every device tree lookup
+		 * afterwards -- the /arm-io children, the UFS host and PHY nodes,
+		 * /chosen/dram-base -- reads whatever SecureDTInit was given.
+		 *
+		 * The boot arguments are not in the kernel image: const_boot_args
+		 * is all zeroes in the file and is filled at run time from the
+		 * structure the previous stage hands over in x0.  On this board
+		 * that previous stage is the stock Android bootloader, because the
+		 * kernel is booted with `fastboot boot`, and it has no reason to
+		 * fill in an iOS device tree.  So the tree the kernel sees is
+		 * whatever those bytes happen to be, which is why /chosen/dram-base
+		 * reads a different number on every boot and why the UFS controller
+		 * has never been matched: there is no node to match.
+		 *
+		 * So print the pointer, the length, and whether the region holds a
+		 * tree that mentions the controller at all.  A pointer of zero, a
+		 * length of zero, or a region without "ufshc" in it says the same
+		 * thing three different ways, and the board's own tree does have
+		 * that node -- out/nio.adt has /arm-io/ufs in it, and the payload
+		 * that carries it has "ufshc" in it too.
+		 */
+		{
+			unsigned char *tree = (unsigned char *)PE_state.deviceTreeHead;
+			unsigned int   len = PE_state.deviceTreeSize;
+			unsigned int   i;
+			int            foundUfs = 0;
+			int            foundArmIo = 0;
+			int            printable = 0;
+
+			printf("\nnio: dt head=%p len=%u virtBase=0x%llx physBase=0x%llx",
+			    (void *)PE_state.deviceTreeHead, len,
+			    (unsigned long long)boot_args_ptr->virtBase,
+			    (unsigned long long)boot_args_ptr->physBase);
+			if (tree != NULL && len != 0 && len < (16u << 20)) {
+				for (i = 0; i + 5 <= len; i++) {
+					if (memcmp(tree + i, "ufshc", 5) == 0) {
+						foundUfs = 1;
+						break;
+					}
+				}
+				for (i = 0; i + 6 <= len; i++) {
+					if (memcmp(tree + i, "arm-io", 6) == 0) {
+						foundArmIo = 1;
+						break;
+					}
+				}
+				for (i = 0; i < (len < 64 ? len : 64); i++) {
+					if (tree[i] >= 0x20 && tree[i] < 0x7f) {
+						printable++;
+					}
+				}
+			}
+			printf(" arm-io=%d ufshc=%d printable=%d/64",
+			    foundArmIo, foundUfs, printable);
+			printf("\n");
+		}
 		PE_state.video.v_baseAddr = boot_args_ptr->Video.v_baseAddr;
 		PE_state.video.v_rowBytes = boot_args_ptr->Video.v_rowBytes;
 		PE_state.video.v_width = boot_args_ptr->Video.v_width;
