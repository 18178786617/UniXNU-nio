nio: enable bulk EP only at connect, not before EP0 setup

sweet 0073/0074 (the working enumeration) set DALEPENA=0x3 (EP0 only)
before ud_start_setup(); data endpoints are enabled incrementally at
connect (sweet 0075). The bulk rebuild set DALEPENA=0x9 (EP0 + EP1 IN)
before EP0 setup, and STARTTRANSFER wedges (run 670: USG1 yes, USG2 no).
Restore the sweet ordering: EP0 only for control setup, then OR in the
bulk EP enable bit in the connect-done handler after it is configured.

diff --git a/bsd/dev/nio_usb.c b/bsd/dev/nio_usb.c
--- a/bsd/dev/nio_usb.c
+++ b/bsd/dev/nio_usb.c
@@ -432,8 +432,10 @@
 			    (1u << 8) | (1u << 10) | (1u << 25), 0);
 		ud.configured = true;
 		/* nio: bulk IN EP1 (physical 3) for console stream */
-		if (ud_epcmd(BULK_EP, DEPCMD_SETEPCONFIG, (1u << 1) | (512u << 3), (2u << 8) | (BULK_EP << 25), 0) == 0)
+		if (ud_epcmd(BULK_EP, DEPCMD_SETEPCONFIG, (1u << 1) | (512u << 3), (2u << 8) | (BULK_EP << 25), 0) == 0) {
 			ud_epcmd(BULK_EP, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0);
+			dwc_wr(DALEPENA, dwc_rd(DALEPENA) | (1u << BULK_EP));  /* nio: enable bulk EP1 IN here (sweet 0075 pattern) */
+		}
 			printf("nio: USB: connected, speed %u\n", speed);
 		} else if (type == 0) {
 			printf("nio: USB: disconnect\n");
@@ -594,7 +596,7 @@
 		return;
 	}
 	nio_usb_mark(" USBD");
-	dwc_wr(DALEPENA, 0x9);   /* EP0 + EP1 IN bulk */
+	dwc_wr(DALEPENA, 0x3);   /* nio: EP0 only here; bulk EP1 enabled at connect (sweet 0073/74/75 pattern) */
 	nio_usb_mark(" USF1");
 	ud_start_setup();
 	nio_usb_mark(" USF2");
