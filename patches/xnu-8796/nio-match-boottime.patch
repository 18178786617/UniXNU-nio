Timestamp the matching trace from the boot clock

clock_get_system_microtime is the system clock, seeded from the device's
real-time clock: its zero is not the boot, and it can be adjusted.  The
intervals between two matching rounds are what the panel has to be read for,
and those are only meaningful against the boot clock, which counts from the
boot and never moves backwards.
---
diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index d7d3433..ec90d7d 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -3823,10 +3823,10 @@ IOService::probeCandidates( OSOrderedSet * matches )
 		static uint32_t nio_probe_cand;
 		if ((++nio_probe_cand & 0x0u) == 0) {
 			clock_sec_t nio_sec;
-			clock_usec_t nio_usec;
+			clock_nsec_t nio_usec;
 			uint32_t nio_now = 0;
 
-			clock_get_system_microtime(&nio_sec, &nio_usec);
+			clock_get_boottime_microtime(&nio_sec, &nio_usec);
 			nio_now = nio_usec + (uint32_t)(nio_sec % 1000) * 1000000u;
 			printf("\nM%u/%d %s %u", nio_probe_cand,
 			    matches ? matches->getCount() : -1,
