Print a beacon that does not depend on timers

The heartbeat thread prints HB 1 and stops, and nobody can say whether that is
because the kernel died or because delay() needs timers that are not running.
A second thread spins on its own and writes V1 V2 V3 to the framebuffer every
few million iterations, so a screen full of V up to the reset proves the
machine kept running and the reset is a watchdog; a V series that stops early
proves the kernel stops there.
---
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index 7ba85df..daaaf13 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -439,6 +439,26 @@ nio_dc_putu(unsigned long v)
 	nio_dc_puts(&buf[i]);
 }
 
+/* nio: a beacon that never sleeps.  The heartbeat thread below uses delay(),
+ * which needs working timers; it prints HB 1 and stops, and that tells us
+ * nothing about whether the kernel is alive.  This one spins on its own and
+ * writes one letter every few million iterations, so the framebuffer shows
+ * whether the machine keeps running right up to the reset. */
+static void
+nio_beacon_thread(void *arg, wait_result_t wr)
+{
+	volatile unsigned long n = 0;
+	unsigned long mark = 0;
+	for (;;) {
+		n++;
+		if ((n % 2000000ul) == 0) {
+			nio_dc_puts("V");
+			nio_dc_putu(++mark);
+			nio_dc_puts(" ");
+		}
+	}
+}
+
 static void
 nio_heartbeat_thread(void *arg, wait_result_t wr)
 {
@@ -485,6 +505,10 @@ kernel_startup_initialize_upto(startup_subsystem_id_t upto)
 		} else {
 			printf("nio: hb thread failed\n");
 		}
+		if (kernel_thread_start(nio_beacon_thread, NULL, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+			printf("nio: beacon thread started\n");
+		}
 	}
 
 	assert(startup_phase < upto);
