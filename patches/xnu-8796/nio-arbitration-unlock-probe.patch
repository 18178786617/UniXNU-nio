Say on the framebuffer whether the arbitration lock can be taken

run-335, run-338 and run-340 all end their panel on "SM busy ok" and never
print "SM unlocked", and that probe sits immediately before
unlockForArbitration() -- whose first statement is IOTakeLock on the global
arbitration queue lock.  The next step is to find out whether that global
lock is what the matching thread waits on.

The probe takes it with IOLockTryLock first and writes U2T or U2B straight
into the framebuffer through cons_ops[1].putc, the console blob's own
writer, so the answer appears even if the console is what is wedged.  The
blocking take follows exactly as before, so the kernel behaves the same
when the mark says U2B.
---
diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 5ea66c4..8553dc9 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -1946,8 +1946,20 @@ IOService::unlockForArbitration( void )
 	bool                          found;
 	ArbitrationLockQueueElement * element;
 
-	// lock global access
-	IOTakeLock( gArbitrationLockQueueLock );
+	/* nio: run-335/338/340 stop right before "SM unlocked", and the only
+	 * thing between the two probes is this take of the global arbitration
+	 * queue lock.  Try it without blocking and say the answer on the
+	 * framebuffer: U2T means this thread got the lock (the stall is further
+	 * down), U2B means another thread holds it and the matching thread waits
+	 * here forever.  The blocking take still follows, so the kernel keeps
+	 * its old behaviour. */
+	nio_u_mark("\nnio: U1");
+	if (IOLockTryLock( gArbitrationLockQueueLock )) {
+		nio_u_mark(" U2T");
+	} else {
+		nio_u_mark(" U2B");
+		IOTakeLock( gArbitrationLockQueueLock );
+	}
 
 	// find the lock element for this object (ie. on active queue)
 	found = false;
@@ -3906,6 +3918,18 @@ struct nio_wd_console_ops {
 };
 extern struct nio_wd_console_ops cons_ops[];
 
+/* nio: put a short mark on the framebuffer through the console blob's own
+ * writer -- no lock, no ring.  The arbitration unlock runs on the matching
+ * thread everything else waits for, so its marks have to appear even when
+ * the console path is the thing that is stuck. */
+static void
+nio_u_mark(const char * s)
+{
+	while (*s != '\0') {
+		cons_ops[1].putc(*s++, true);
+	}
+}
+
 static void
 nio_match_watchdog(void *arg, wait_result_t wr)
 {
