 			IOLockUnlock( gIOServiceBusyLock );
 		} else if (!sync || (kIOServiceAsynchronous & options)) {
-			_IOServiceJob::startJob( this, kMatchNubJob, options );
+			/* nio: the configuration thread is created and never runs
+			 * on this board: run 459 showed 'CFG mk ok' with a real
+			 * thread handle and no 'CFG alive', and run 456 showed four
+			 * jobs outstanding with none of them taken.  The root nub
+			 * is matched on this path, so it is the one service that
+			 * can never be matched, and everything else hangs off it.
+			 * It is matched in place instead, on this thread, which is
+			 * what the synchronous branch below does.  doServiceMatch()
+			 * sets kIOServiceConfigRunning, so the guard at the top of
+			 * this function keeps a second round from happening. */
+			if (getProvider() == NULL) {
+				printf("\nnio: SM inline %s", getName() ? getName() : "?");
+				doServiceMatch( options );
+				printf("\nnio: SM inline done");
+			} else {
+				_IOServiceJob::startJob( this, kMatchNubJob, options );
+			}
 		} else {
 			do {
 				if ((__state[1] & kIOServiceNeedConfigState)) {
@@ -5426,6 +5442,7 @@ _IOConfigThread::configThread( const char * name )
 			continue;
 		}
 		printf("\nnio: CFG mk ok t=%p", (void *) thread);
+		nio_u_mark("\nMKOK");
 
 		char threadName[MAXTHREADNAMESIZE];
 		snprintf(threadName, sizeof(threadName), "IOConfigThread_'%s'", name);
@@ -6120,6 +6137,7 @@ _IOConfigThread::main(void * arg, wait_result_t result)
 	IOService   *   nub;
 	bool            alive = true;
 	printf("\nnio: CFG alive");
+	nio_u_mark("\nALIVE");
 	kern_return_t   kr;
 	thread_precedence_policy_data_t precedence = { -1 };
 
@@ -6135,7 +6153,9 @@ _IOConfigThread::main(void * arg, wait_result_t result)
 //	randomDelay();
 
 		printf("\nnio: CFG wait");
+		nio_u_mark("\nWAIT");
 		semaphore_wait( gJobsSemaphore );
+		nio_u_mark("\nPICK");
 
 		IOTakeLock( gJobsLock );
 		job = (_IOServiceJob *) gJobs->getFirstObject();
