+/* nio: a number on the panel, without a format string. */
+static void
+nio_uhex(unsigned long v)
+{
+	static const char h[] = "0123456789abcdef";
+	char b[16];
+	char out[17];
+	int i = 0;
+	int j = 0;
+
+	if (v == 0) {
+		nio_u_mark("0");
+		return;
+	}
+	while (v != 0) {
+		b[i++] = h[v & 0xf];
+		v >>= 4;
+	}
+	while (i > 0) {
+		out[j++] = b[--i];
+	}
+	out[j] = '\0';
+	nio_u_mark(out);
+}
 }
 
