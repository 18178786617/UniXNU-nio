Trace every startup function

run-86 printed all eight kalloc_init landmarks, so both of the
STARTUP_RANK_THIRD functions complete and the stall sits in a later
startup function.  Print an enter/exit pair around each call: the last
enter without a matching exit names the function that hangs, and its
address symbolizes with tools/kernel-symbols.py.

---
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index bec97fb..6861417 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -407,6 +407,11 @@ kernel_startup_initialize_upto(startup_subsystem_id_t upto)
 		}
 		startup_phase = cur->subsystem - 1;
 		kernel_startup_log(cur->subsystem);
+		if (startup_phase >= STARTUP_SUB_KPRINTF) {
+			printf("nio: S%u r%d n%u a%08x\n", cur->subsystem,
+			    cur->rank, (unsigned)(cur - startup_entries),
+			    (unsigned)(uintptr_t)cur->func);
+		}
 		cur->func(cur->arg);
 		startup_entry_cur = ++cur;
 	}
