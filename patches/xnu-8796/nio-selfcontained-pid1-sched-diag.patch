nio: self-contained PID1 scheduler landmark diagnostics

Define nio_pid1_thread and nio_user_path_flags locally in sched_prim.c,
record the cloned init thread after cloneproc() in bsd_utaskbootstrap(), set
0x100 when thread_select() runs and 0x80 when it sees PID1 runnable on a runq,
and print the combined PATH flags just before the boot thread blocks.  No
scheduling behaviour change, no probe squares, no beacons.

0x100 only = scheduler ran but never saw PID1 runnable; 0x180 = saw it
runnable but chose another thread; neither = boot thread never reached the
scheduler.  This is the one new fact 645 never captured.

diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index bd67e3d..fcd45c9 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1284,6 +1284,8 @@ bsd_init(void)
 	 * (runs 607-612). Hand the CPU to the init thread here; if this thread
 	 * never returns, the init thread is running bsdinit_task and launchd,
 	 * which is the goal. */
+	{ extern volatile unsigned int nio_user_path_flags;
+	  printf("\nnio: PID1 PATH=%#x\n", (unsigned)nio_user_path_flags); }
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
@@ -1448,6 +1450,7 @@ bsd_utaskbootstrap(void)
 	nio_bmark("\nnio: UT pre-cloneproc");
 	thread = cloneproc(TASK_NULL, NULL, kernproc, CLONEPROC_FLAGS_MEMSTAT_INTERNAL);
 	nio_bmark("\nnio: UT post-cloneproc");
+	{ extern thread_t nio_pid1_thread; nio_pid1_thread = thread; }
 
 	/* Hold the reference as it will be dropped during shutdown */
 	nio_bmark("\nnio: UT post-procfind");
diff --git a/osfmk/kern/sched_prim.c b/osfmk/kern/sched_prim.c
index 8e29586..decfe8b 100644
--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -384,6 +384,10 @@ sched_realtime_timebase_init(void);
 static void
 sched_timer_deadline_tracking_init(void);
 
+/* nio: read-only PID1 scheduler diagnostics. No behaviour change. */
+thread_t nio_pid1_thread = THREAD_NULL;
+volatile unsigned int nio_user_path_flags = 0;
+
 #if     DEBUG
 extern int debug_task;
 #define TLOG(a, fmt, args...) if(debug_task & a) kprintf(fmt, ## args)
@@ -2433,6 +2437,13 @@ thread_select(thread_t          thread,
 	processor_set_t         pset = processor->processor_set;
 	thread_t                        new_thread = THREAD_NULL;
 
+	/* nio: did the scheduler ever see PID1 runnable on a runq? */
+	nio_user_path_flags |= 0x100;
+	if (nio_pid1_thread != THREAD_NULL &&
+	    (nio_pid1_thread->state & TH_RUN) && nio_pid1_thread->runq != PROCESSOR_NULL) {
+		nio_user_path_flags |= 0x80;
+	}
+
 	assert(processor == current_processor());
 	assert((thread->state & (TH_RUN | TH_TERMINATE2)) == TH_RUN);
 
