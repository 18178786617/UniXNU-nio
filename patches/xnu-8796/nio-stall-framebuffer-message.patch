Write the stall message on the framebuffer before panicking

run-338's boot ended with the panel going dark, and a dark panel cannot say
whether the stall watchdog ever fired.  The heartbeat already writes through
cons_ops[1].putc -- the entry the console blob replaced with a direct
framebuffer writer, no lock and no ring -- so the watchdog says it there too,
before the panic runs: STALL and the matching round count land on the panel
with no console dependency, and a photo of the last seconds catches them
whatever the panic path does afterwards.

The struct and the extern live at file scope: the first cut declared them at
block scope and the compiler refused it -- an extern variable of a
no-linkage type cannot name another translation unit's definition.
---
diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 192a948..5ea66c4 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -3895,6 +3895,17 @@ nio_reason_rank(int reason)
  * the framebuffer, so it appears even when the console is what is stuck. */
 static volatile uint32_t nio_match_progress;
 
+/* nio: the framebuffer writer's console ops.  cons_ops[1].putc is the entry
+ * the console blob replaced with a direct framebuffer writer: no lock, no
+ * ring.  This struct mirrors osfmk/console/serial_protos.h's struct
+ * console_ops, which IOService.cpp does not include -- the layout is what
+ * matters, and the symbol is the one serial_console.c defines. */
+struct nio_wd_console_ops {
+	void (*putc)(char, bool);
+	int (*getc)(bool);
+};
+extern struct nio_wd_console_ops cons_ops[];
+
 static void
 nio_match_watchdog(void *arg, wait_result_t wr)
 {
@@ -3914,6 +3925,30 @@ nio_match_watchdog(void *arg, wait_result_t wr)
 			continue;
 		}
 		if (since && (ns - since) >= 15ULL * 1000000000ULL) {
+			/* nio: say it on the framebuffer through the same unlocked path the
+			 * heartbeat uses.  run-338's boot ended with the panel going dark
+			 * before anything could say whether the watchdog fired -- these
+			 * characters go on the panel BEFORE the panic runs, with no lock
+			 * and no console, so a photo of the last seconds catches them
+			 * whatever happens afterwards. */
+			{
+				const char *nio_m = "\nnio: STALL rounds=";
+				unsigned nio_v = nio_match_progress;
+				char nio_buf[12];
+				int nio_i = (int)sizeof (nio_buf) - 1;
+
+				while (*nio_m != '\0') {
+					cons_ops[1].putc(*nio_m++, true);
+				}
+				nio_buf[nio_i] = '\0';
+				do {
+					nio_buf[--nio_i] = (char)('0' + (nio_v % 10u));
+					nio_v /= 10u;
+				} while (nio_v != 0);
+				for (const char *nio_s = &nio_buf[nio_i]; *nio_s != '\0'; nio_s++) {
+					cons_ops[1].putc(*nio_s, true);
+				}
+			}
 			panic("nio: the matching path stalled (rounds=%u)", nio_match_progress);
 		}
 	}
