Print six letters of the name, and mark every matching round

run-374 reached service 46 (B45 Arm, B46 IOC) and then no new number, while a
thread kept stamping #44.  Three letters are not enough to name the service,
and nothing marks how many matching rounds run around those starts.

Six letters on the B line, and an S mark with the same service number at the
top of startMatching: one screen then says how far the names go and how many
rounds produced them.
---
diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 3388c04..0a572fe 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -1125,6 +1125,10 @@ IOService::startMatching( IOOptionBits options )
 		return;
 	}
 
+	/* nio: how many matching rounds run, against how many services start. */
+	nio_u_mark("\nS");
+	nio_u_seq();
+
 	IOService * provider;
 	UInt32      prevBusy = 0;
 	bool        needConfig;
@@ -1156,6 +1160,9 @@ IOService::startMatching( IOOptionBits options )
 		nio_b[nio_p++] = (nio_n && nio_n[0]) ? nio_n[0] : '?';
 		nio_b[nio_p++] = (nio_n && nio_n[1]) ? nio_n[1] : ' ';
 		nio_b[nio_p++] = (nio_n && nio_n[2]) ? nio_n[2] : ' ';
+		nio_b[nio_p++] = (nio_n && nio_n[3]) ? nio_n[3] : ' ';
+		nio_b[nio_p++] = (nio_n && nio_n[4]) ? nio_n[4] : ' ';
+		nio_b[nio_p++] = (nio_n && nio_n[5]) ? nio_n[5] : ' ';
 		nio_b[nio_p] = '\0';
 		nio_u_mark(nio_b);
 	}
