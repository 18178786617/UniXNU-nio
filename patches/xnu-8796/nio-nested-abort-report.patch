Report the fault that a guard-page abort was hiding

run-249/250 show pc = fleh_dispatch64's NEON spill and far = the intstack low
guard: the vector built a frame that straddles the guard page, so the abort it
raised is a second exception and the frame that was being filled is the only
place the real pc/far survive.

A kprintf there does not reach the panel (the console is busy exactly when this
happens, and the line was long enough to wrap), so put the older frame's pc,
far, esr and sp plus the cpu's intstack top on two short lines inside the
existing panic_plain, with every read range-checked.  Zeros mean the state was
not a nested spill.
---
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 2cc442e..a3606f6 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -466,6 +466,41 @@ panic_with_thread_kernel_state(const char *msg, arm_saved_state_t *ss)
 	ss_valid = is_saved_state64(ss);
 	arm_saved_state64_t *state = saved_state64(ss);
 
+	/*
+	 * nio: when the vector runs into a guard page while spilling a frame, the
+	 * frame it was filling is left exactly one arm_context_t above this one and
+	 * still holds the fault that got us here (nio-fleh-early-fault.patch saves
+	 * pc/far/esr before the NEON spill).  Collect it and print it through the
+	 * same panic_plain as the dump below: kprintf is dropped when the console is
+	 * busy, and a fault inside the console is exactly when this panic happens.
+	 * Every value is range-checked, so a wild sp yields zeros, not a second
+	 * fault.
+	 */
+	uint64_t nio_prev_pc = 0, nio_prev_far = 0, nio_prev_sp = 0;
+	uint32_t nio_prev_esr = 0;
+	uint64_t nio_istk = 0;
+	if (ss_valid) {
+		uintptr_t nio_prev = (uintptr_t)state->sp;
+		uintptr_t nio_here = (uintptr_t)state;
+		cpu_data_t *nio_cdp = getCpuDatap();
+
+		if (nio_cdp != NULL) {
+			nio_istk = (uint64_t)nio_cdp->intstack_top;
+		}
+		if (nio_prev > nio_here && (nio_prev - nio_here) == 0x350 &&
+		    (nio_prev & 7) == 0 &&
+		    nio_prev >= (uintptr_t)gVirtBase && nio_prev < (uintptr_t)static_memory_end) {
+			uint64_t nio_pc = *(volatile uint64_t *)(nio_prev + 0x108);
+
+			if (nio_pc >= (uintptr_t)gVirtBase && nio_pc < (uintptr_t)static_memory_end) {
+				nio_prev_pc = nio_pc;
+				nio_prev_far = *(volatile uint64_t *)(nio_prev + 0x118);
+				nio_prev_esr = *(volatile uint32_t *)(nio_prev + 0x120);
+				nio_prev_sp = (uint64_t)(nio_prev + 0x350);
+			}
+		}
+	}
+
 	os_atomic_cmpxchg(&original_faulting_state, NULL, state, seq_cst);
 
 	// rdar://80659177
@@ -489,7 +524,9 @@ panic_with_thread_kernel_state(const char *msg, arm_saved_state_t *ss)
 	    "\t  x20: 0x%016llx x21: 0x%016llx  x22: 0x%016llx  x23: 0x%016llx\n"
 	    "\t  x24: 0x%016llx x25: 0x%016llx  x26: 0x%016llx  x27: 0x%016llx\n"
 	    "\t  x28: 0x%016llx fp:  0x%016llx  lr:  0x%016llx  sp:  0x%016llx\n"
-	    "\t  pc:  0x%016llx cpsr: 0x%08x         esr: 0x%08x          far: 0x%016llx\n",
+	    "\t  pc:  0x%016llx cpsr: 0x%08x         esr: 0x%08x          far: 0x%016llx\n"
+	    "\tnio prev pc=%llx far=%llx\n"
+	    "\tnio prev esr=%x sp=%llx istk=%llx\n",
 	    msg, state->pc, state->lr, ss, (ss_valid ? "" : " INVALID"),
 	    state->x[0], state->x[1], state->x[2], state->x[3],
 	    state->x[4], state->x[5], state->x[6], state->x[7],
@@ -499,7 +536,8 @@ panic_with_thread_kernel_state(const char *msg, arm_saved_state_t *ss)
 	    state->x[20], state->x[21], state->x[22], state->x[23],
 	    state->x[24], state->x[25], state->x[26], state->x[27],
 	    state->x[28], state->fp, state->lr, state->sp,
-	    state->pc, state->cpsr, state->esr, state->far);
+	    state->pc, state->cpsr, state->esr, state->far,
+	    nio_prev_pc, nio_prev_far, nio_prev_esr, nio_prev_sp, nio_istk);
 }
 
 void
