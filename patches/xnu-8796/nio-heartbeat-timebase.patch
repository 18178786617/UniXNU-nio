Drive the heartbeat from the continuous timebase

The heartbeat's interval was measured with clock_get_boottime_microtime,
which on this board never moves, so it printed once and then never again:
the condition (now - last) >= 1s could not become true a second time.

mach_absolute_time() is the clock the kernel itself uses for its timeouts,
and it moves.  The line now carries the microsecond stamp of that clock and
the tick counter, so two lines say how long a second really is and how fast
the ticks run.
---
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index 98f885b..9ce8788 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -398,19 +398,17 @@ static void
 nio_heartbeat_thread(void *arg, wait_result_t wr)
 {
 	unsigned n = 0;
-	uint32_t nio_hb_last = 0;
+	uint64_t nio_hb_last = 0;
 	for (;;) {
-		clock_sec_t nio_hb_sec;
-		clock_nsec_t nio_hb_usec;
-		uint32_t nio_hb_now = 0;
+		uint64_t nio_hb_abstime = 0, nio_hb_ns = 0;
 
 		delay(100);
 		n++;
-		clock_get_boottime_microtime(&nio_hb_sec, &nio_hb_usec);
-		nio_hb_now = nio_hb_usec + (uint32_t)(nio_hb_sec % 1000) * 1000000u;
-		if ((uint32_t)(nio_hb_now - nio_hb_last) >= 1000000u) {
-			nio_hb_last = nio_hb_now;
-			printf("\nnio: hb %u %u", n, nio_hb_now);
+		clock_get_uptime(&nio_hb_abstime);
+		absolutetime_to_nanoseconds(nio_hb_abstime, &nio_hb_ns);
+		if ((nio_hb_ns - nio_hb_last) >= 1000000000ULL) {
+			nio_hb_last = nio_hb_ns;
+			printf("\nnio: hb %u %u", n, (uint32_t)(nio_hb_ns / 1000));
 		}
 	}
 }
