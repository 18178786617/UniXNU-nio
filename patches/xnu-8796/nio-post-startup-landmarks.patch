Mark the calls between the last startup phase and bsd_init

The kernel finishes the startup phase and does not reach
bsd_init: the last startup landmark is on the screen and
bsd_init's own first landmark is not.  The stretch between the
two is a list of calls in kernel_bootstrap_thread(), and this
patch puts a number on each of them.

The numbers are counted from 9000 in the order the source has
the calls in:

    9000 commpage             9005 static_trust_cache
    9001 mac_policy           9006 kext_bootstrap_removed
    9002 vnguard_policy       9007 machine_lockdown
    9003 dtrace_early         9008 pe_lockdown_iokit
    9004 trust_cache          9009 bsd_init

One format string for all of them: the compiler merges the
identical literals, so a marker costs the instructions and
nothing else.  The console blob lives in the tail padding of
__TEXT_EXEC and the space there is what every marker has to
fit into.

---
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index b790d0d..9a66186 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -712,20 +712,24 @@ kernel_bootstrap_thread(void)
 	 *	Initialize the shared region module.
 	 */
 	vm_commpage_init();
+	printf("nio: %u\n", 9000);
 	vm_commpage_text_init();
 
 #if CONFIG_MACF
 	kernel_bootstrap_log("mac_policy_initmach");
 	mac_policy_initmach();
+	printf("nio: %u\n", 9001);
 #if CONFIG_VNGUARD
 	kernel_bootstrap_log("vnguard_policy_init");
 	vnguard_policy_init();
+	printf("nio: %u\n", 9002);
 #endif
 #endif
 
 #if CONFIG_DTRACE
 	kernel_bootstrap_log("dtrace_early_init");
 	dtrace_early_init();
+	printf("nio: %u\n", 9003);
 	sdt_early_init();
 #endif
 
@@ -739,9 +743,11 @@ kernel_bootstrap_thread(void)
 
 	/* Initialize the runtime for the trust cache interface */
 	trust_cache_runtime_init();
+	printf("nio: %u\n", 9004);
 
 	/* Load the static and engineering trust caches */
 	load_static_trust_cache();
+	printf("nio: %u\n", 9005);
 #endif
 
 	kernel_startup_initialize_upto(STARTUP_SUB_LOCKDOWN);
@@ -754,10 +760,12 @@ kernel_bootstrap_thread(void)
 	 */
 	kernel_bootstrap_log("OSKextRemoveKextBootstrap");
 	OSKextRemoveKextBootstrap();
+	printf("nio: %u\n", 9006);
 
 	/* No changes to kernel text and rodata beyond this point. */
 	kernel_bootstrap_log("machine_lockdown");
 	machine_lockdown();
+	printf("nio: %u\n", 9007);
 
 #ifdef CONFIG_XNUPOST
 	kern_return_t result = kernel_list_tests();
@@ -771,6 +779,7 @@ kernel_bootstrap_thread(void)
 #ifdef  IOKIT
 	kernel_bootstrap_log("PE_lockdown_iokit");
 	PE_lockdown_iokit();
+	printf("nio: %u\n", 9008);
 #endif
 	/*
 	 * max_cpus must be nailed down by the time PE_lockdown_iokit() finishes,
@@ -788,6 +797,7 @@ kernel_bootstrap_thread(void)
 	 */
 #ifdef  MACH_BSD
 	bsd_init();
+	printf("nio: %u\n", 9009);
 #endif
 
 
