Mark the calls between the last startup phase and bsd_init

The startup phase finishes and the kernel does not reach bsd_init:
the last startup landmark is on the screen and bsd_init's own first
landmark is not.  The stretch between them is a list of calls, and
each of them is announced by kernel_bootstrap_log() with the name of
the step, so the screen says which of them ran last.

The markers are numbers counted from 9000, one per step in the order
the source has them:

    9000 commpage              9006 kext_bootstrap_removed
    9001 commpage_text         9007 machine_lockdown
    9002 mac_policy            9008 pe_lockdown_iokit
    9003 dtrace_early          9009 vm_restrictions
    9004 trust_cache          9010 kperf
    9005 static_trust_cache   9011 bsd_init

They are numbers because the panel is read from a photograph of a
phone that is held by hand, and a short line is legible where a long
one is not.  The numbers start at 9000 so that they cannot be
mistaken for a startup entry's number, which is counted from 0.

---
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index bec97fb..f1ecf52 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -712,7 +712,9 @@ kernel_bootstrap_thread(void)
 	 *	Initialize the shared region module.
 	 */
 	vm_commpage_init();
+	printf("nio: %u\n", 9000);
 	vm_commpage_text_init();
+	printf("nio: %u\n", 9001);
 
 #if CONFIG_MACF
 	kernel_bootstrap_log("mac_policy_initmach");
@@ -722,12 +724,14 @@ kernel_bootstrap_thread(void)
 	vnguard_policy_init();
 #endif
 #endif
+	printf("nio: %u\n", 9011);
 
 #if CONFIG_DTRACE
 	kernel_bootstrap_log("dtrace_early_init");
 	dtrace_early_init();
 	sdt_early_init();
 #endif
+	printf("nio: %u\n", 9010);
 
 #if CODE_SIGNING_MONITOR
 	kernel_bootstrap_log("provisioning_profile_init");
@@ -739,9 +743,11 @@ kernel_bootstrap_thread(void)
 
 	/* Initialize the runtime for the trust cache interface */
 	trust_cache_runtime_init();
+	printf("nio: %u\n", 9002);
 
 	/* Load the static and engineering trust caches */
 	load_static_trust_cache();
+	printf("nio: %u\n", 9003);
 #endif
 
 	kernel_startup_initialize_upto(STARTUP_SUB_LOCKDOWN);
@@ -754,10 +760,12 @@ kernel_bootstrap_thread(void)
 	 */
 	kernel_bootstrap_log("OSKextRemoveKextBootstrap");
 	OSKextRemoveKextBootstrap();
+	printf("nio: %u\n", 9004);
 
 	/* No changes to kernel text and rodata beyond this point. */
 	kernel_bootstrap_log("machine_lockdown");
 	machine_lockdown();
+	printf("nio: %u\n", 9005);
 
 #ifdef CONFIG_XNUPOST
 	kern_return_t result = kernel_list_tests();
@@ -771,16 +779,19 @@ kernel_bootstrap_thread(void)
 #ifdef  IOKIT
 	kernel_bootstrap_log("PE_lockdown_iokit");
 	PE_lockdown_iokit();
+	printf("nio: %u\n", 9006);
 #endif
 	/*
 	 * max_cpus must be nailed down by the time PE_lockdown_iokit() finishes,
 	 * at the latest
 	 */
 	vm_set_restrictions(machine_info.max_cpus);
+	printf("nio: %u\n", 9007);
 
 
 #if KPERF
 	kperf_init_early();
+	printf("nio: %u\n", 9008);
 #endif
 
 	/*
@@ -788,6 +799,7 @@ kernel_bootstrap_thread(void)
 	 */
 #ifdef  MACH_BSD
 	bsd_init();
+	printf("nio: %u\n", 9009);
 #endif
 
 
