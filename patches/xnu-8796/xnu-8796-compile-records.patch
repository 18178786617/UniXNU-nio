The compile records the archive builders replay.

xnu-10063 asks the compiler to write a JSON compilation record next to every
object it builds (-MJ). xnu-8796 does not: its three compile rules carry only
-MD/-MF/-MP, the dependency file. The archive builders read those records --
build-mockfs-fixture.py replays vfs_conf.o.json to compile the three mockfs
sources, build-adreno650.py replays bsd_init.o.json and
IOPlatformExpert.cpo.json for the GPU objects, build-libpthread-kernel.py
replays prng_random.o.json -- and the build driver reads startup.o.json to
decide whether the bootstrap pass has produced what it needs.

Without the records the bootstrap pass fails its link (the mockfs symbols are
only in libmockfs_fixture.a, which the bootstrap link does not have) and the
failure cannot be swallowed, because the record that says "the compile part
worked" does not exist. The 17.7.11 build never noticed: xnu-10063 writes
the records.

-MJ is clang's own option and its output is the compilation database entry
the builders expect: directory, file, arguments.

diff --git a/makedefs/MakeInc.rule b/makedefs/MakeInc.rule
index 59e4063..2ed1715 100644
--- a/makedefs/MakeInc.rule
+++ b/makedefs/MakeInc.rule
@@ -392,7 +392,7 @@ do_exporthdrs_md: $(EXPORT_MD_GEN_INC_FILES)  $(EXPORT_MD_INC_FILES)
 #
 
 S_RULE_0=@$(LOG_AS) "$@"
-S_RULE_1A=$(_v)${S_KCC} -c ${SFLAGS} -MD -MF $(@:o=d) -MP ${$@_SFLAGS_ADD} ${INCFLAGS} ${$@_INCFLAGS}
+S_RULE_1A=$(_v)${S_KCC} -c ${SFLAGS} -MD -MF $(@:o=d) -MJ $(@:o=o.json) -MP ${$@_SFLAGS_ADD} ${INCFLAGS} ${$@_INCFLAGS}
 S_RULE_1B=$(<F)
 S_RULE_2=
 
@@ -400,7 +400,7 @@ S_RULE_2=
 # Compilation rules to generate .o from .c for normal files
 #
 C_RULE_0=@$(LOG_CC) "$@"
-C_RULE_1A=$(_v)${KCC} -c ${filter-out ${$@_CFLAGS_RM}, ${CFLAGS} ${CWARNFLAGS}} -MD -MF $(@:o=d) -MP ${$@_CFLAGS_ADD} ${$@_CWARNFLAGS_ADD} ${INCFLAGS} ${$@_INCFLAGS}
+C_RULE_1A=$(_v)${KCC} -c ${filter-out ${$@_CFLAGS_RM}, ${CFLAGS} ${CWARNFLAGS}} -MD -MF $(@:o=d) -MJ $(@:o=o.json) -MP ${$@_CFLAGS_ADD} ${$@_CWARNFLAGS_ADD} ${INCFLAGS} ${$@_INCFLAGS}
 C_RULE_1B=$(<F)
 C_RULE_2=
 
@@ -424,7 +424,7 @@ C_RULE_4B_D=${C_RULE_4B}
 #   The config tool slickly changes the last source filename char to 'o'
 #   for the object filename.
 P_RULE_0=@$(LOG_CXX) "$@"
-P_RULE_1A=$(_v)${KC++} -o $@ -c ${CXXFLAGS} ${filter-out ${$@_CFLAGS_RM}, ${CFLAGS} ${CXXWARNFLAGS}} -MD -MF $(@:o=d) -MP ${$@_CFLAGS_ADD} ${$@_CXXWARNFLAGS_ADD} ${INCFLAGS} ${$@_INCFLAGS}
+P_RULE_1A=$(_v)${KC++} -o $@ -c ${CXXFLAGS} ${filter-out ${$@_CFLAGS_RM}, ${CFLAGS} ${CXXWARNFLAGS}} -MD -MF $(@:o=d) -MJ $(@:o=o.json) -MP ${$@_CFLAGS_ADD} ${$@_CXXWARNFLAGS_ADD} ${INCFLAGS} ${$@_INCFLAGS}
 P_RULE_1B=$(<F)
 P_RULE_2=
 
