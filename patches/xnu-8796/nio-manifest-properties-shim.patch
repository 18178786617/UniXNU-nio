Answer the manifest-properties lookup with a synthetic node

AppleImage4 reads /chosen/manifest-properties during its own start() and panics
when the node is missing, which is exactly what run-285 showed.  The node comes
from iBoot on a real device; a loader port has no manifest to put there.

Return a flat-device-tree node with mixn_match and iuos both zero.  If the panic
changes shape the next attribute it wants is named by the new message.
---
diff --git a/pexpert/gen/device_tree.c b/pexpert/gen/device_tree.c
index d5b61da..5b59f4f 100644
--- a/pexpert/gen/device_tree.c
+++ b/pexpert/gen/device_tree.c
@@ -336,6 +336,35 @@ SecureDTLookupEntry(const DTEntry searchPoint, const char *pathName, DTEntry *fo
 	if (!DTInitialized) {
 		return kError;
 	}
+	/* nio: /chosen/manifest-properties is a node iBoot writes from the img4
+	 * manifest.  Our loader has no manifest to write, and AppleImage4 does
+	 * not tolerate its absence: it panics with "failed to get mix-n-match
+	 * policy: 2" from inside its own start(), which no skip patch can reach.
+	 * Answer the lookup with a synthetic node holding the two policy flags
+	 * the checks read, both zero, in flat-device-tree layout. */
+	if (pathName != NULL &&
+	    (strcmp(pathName, "/chosen/manifest-properties") == 0 ||
+	     strcmp(pathName, "manifest-properties") == 0)) {
+		static struct {
+			uint32_t nProperties;
+			uint32_t nChildren;
+			struct {
+				char     name[kPropNameLength];
+				uint32_t length;
+				uint32_t value;
+			} props[2];
+		} nio_manifest_props = {
+			2, 0,
+			{
+				{ "mixn_match", 4, 0 },
+				{ "iuos", 4, 0 },
+			}
+		};
+		if (foundEntry != NULL) {
+			*foundEntry = (DTEntry)&nio_manifest_props;
+		}
+		return kSuccess;
+	}
 	if (searchPoint == NULL) {
 		cur = DTRootNode;
 	} else {
