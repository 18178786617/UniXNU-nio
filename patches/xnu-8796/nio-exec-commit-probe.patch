nio: mark exec commit / terminate / final-wakeup decisions

698 showed exec succeeds (E06 ret=0) with a valid user PC/SP, no ERET
fault, and no UB01 -- the new exec thread never reaches thread_bootstrap_return.
Mark the remaining decisions in the exec tail in one round:
  C01 error before the commit stage
  C02 exit_with_error path taken (only 3 early gotos reach it)
  C03/C04 task_is_exec_copy -> task_terminate_internal(new_task)
  C05/C06 the FINAL_WAIT task_clear_return_wait that wakes the new thread
Whichever of C02/C04/C06 is last tells whether the new thread was killed,
or simply never woken from its return wait.

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index d14a339..9027d28 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5199,6 +5199,8 @@ __mac_execve(proc_t p, struct __mac_execve_args *uap, int32_t *retval __unused)
 		imgp->ip_cs_error = OS_REASON_NULL;
 	}
 
+		nio_emark("\nnio: C01 pre-commit err=");
+		nio_ehex((unsigned)error);
 	if (!error) {
 		/*
 		 * We need to initialize the bank context behind the protection of
@@ -5282,9 +5284,13 @@ __mac_execve(proc_t p, struct __mac_execve_args *uap, int32_t *retval __unused)
 	}
 
 exit_with_error:
+	nio_emark("\nnio: C02 EXIT_WITH_ERROR err=");
+	nio_ehex((unsigned)error);
 
 	/* terminate the new task it if exec failed  */
+	nio_emark("\nnio: C03 exec_copy check");
 	if (new_task != NULL && task_is_exec_copy(new_task)) {
+		nio_emark("\nnio: C04 TERMINATE new_task");
 		task_terminate_internal(new_task);
 	}
 
@@ -5312,7 +5318,9 @@ exit_with_error:
 		/* Release the thread ref returned by cloneproc */
 		if (imgp->ip_new_thread) {
 			/* wake up the new exec thread */
+			nio_emark("\nnio: C05 before FINAL_WAIT wake");
 			task_clear_return_wait(get_threadtask(imgp->ip_new_thread), TCRW_CLEAR_FINAL_WAIT);
+			nio_emark("\nnio: C06 after FINAL_WAIT wake");
 			thread_deallocate(imgp->ip_new_thread);
 			imgp->ip_new_thread = NULL;
 		}
