Say why a candidate personality is dropped before it is instantiated

The panel shows M<n> from probeCandidates and not one "nio: C" line, and
"nio: C" is printed in the second loop of that function, so the second loop
never runs: every personality is turned away by the first one.  The first
loop has nine doors and this records which one each candidate is turned away
at, so the panel names the door instead of leaving it to guesswork.

The line is printed only for the nubs that dropped every candidate, which is
the symptom, so the nubs that match normally stay quiet.  It carries the
nub's name, the reasons in the order the candidates were offered, and the
class name of the candidate that was turned away for the most interesting
reason -- that name is what says which driver is stuck.
---
diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index dd4ca61..f8de13d 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -3831,6 +3831,53 @@ IOService::invokeNotifiers(OSArray * willSend[])
  * called on the provider instance
  */
 
+/* nio: the class name of a personality, for the panel. */
+static void
+nio_class_name(OSDictionary * match, char * out, int size)
+{
+	OSSymbol * cls = OSDynamicCast(OSSymbol, match->getObject(gIOClassKey));
+	const char * s = cls ? cls->getCStringNoCopy() : "?";
+	int i = 0;
+	while (s[i] && i < size - 1) {
+		out[i] = s[i];
+		i++;
+	}
+	out[i] = '\0';
+}
+
+/* nio: how interesting a reason is; the class name that gets printed is the
+ * one of the candidate that was turned away for the most interesting reason. */
+static int
+nio_reason_rank(int reason)
+{
+	switch (reason) {
+		case 6: return 9;
+		case 5: return 8;
+		case 9: return 7;
+		case 4: return 6;
+		case 7: return 5;
+		case 8: return 4;
+		case 3: return 3;
+		case 2: return 2;
+		case 1: return 1;
+		default: return 0;
+	}
+}
+
+/* nio: record why a candidate was dropped, and keep the class name of the
+ * most interesting one.  The macro is used inside probeCandidates, where the
+ * personality is called 'match'. */
+#define NIO_DROP(n) do { \
+	if (nio_nreasons < 8) { \
+		nio_reasons[nio_nreasons] = (n); \
+		if (nio_reason_rank(n) > nio_best_rank) { \
+			nio_best_rank = nio_reason_rank(n); \
+			nio_class_name(match, nio_best_name, 24); \
+		} \
+		nio_nreasons++; \
+	} \
+} while (0)
+
 void
 IOService::probeCandidates( OSOrderedSet * matches )
 {
@@ -3881,6 +3928,11 @@ IOService::probeCandidates( OSOrderedSet * matches )
 	uint32_t                    dextCount;
 	bool                        isDext;
 	bool                        categoryConsumed;
+	int                         nio_reasons[8];
+	int                         nio_nreasons = 0;
+	int                         nio_best_rank = 0;
+	char                        nio_best_name[24];
+	int                         nio_kept = 0;
 
 	rematchCountProp = NULL;
 	count = 0;
@@ -3928,9 +3980,11 @@ IOService::probeCandidates( OSOrderedSet * matches )
 			client = NULL;
 			isDext = (NULL != match->getObject(gIOUserServerNameKey));
 			if (isDext && !(kIODKEnable & gIODKDebug)) {
+				NIO_DROP(1);
 				continue;
 			}
 			if (isDext && !gIODextRelaunchMax && rematchCountProp) {
+				NIO_DROP(2);
 				continue;
 			}
 			newIsBoot = gIOCatalogue->personalityIsBoot(match);
@@ -3953,6 +4007,7 @@ IOService::probeCandidates( OSOrderedSet * matches )
 				existingIsBoot = client->propertyExists(gIOMatchedAtBootKey);
 				isReplacementCandidate = existingIsBoot && !newIsBoot;
 				if (!isDext && !isReplacementCandidate) {
+					NIO_DROP(3);
 					break;
 				}
 			}
@@ -3960,17 +4015,20 @@ IOService::probeCandidates( OSOrderedSet * matches )
 			// create a copy now in case its modified during matching
 			props = OSDictionary::withDictionary(match, match->getCount());
 			if (NULL == props) {
+				NIO_DROP(4);
 				break;
 			}
 			props->setCapacityIncrement(1);
 
 			// check the nub matches
 			if (false == matchPassive(props, kIOServiceChangesOK | kIOServiceClassDone)) {
+				NIO_DROP(5);
 				break;
 			}
 			if (isReplacementCandidate) {
 				if (canTerminateForReplacement(client)) {
 					client->terminate(kIOServiceTerminateNeedWillTerminate | kIOServiceTerminateWithRematch);
+					NIO_DROP(7);
 					break;
 				}
 			}
@@ -3980,6 +4038,7 @@ IOService::probeCandidates( OSOrderedSet * matches )
 					dextCount++;
 				}
 				if (categoryConsumed) {
+					NIO_DROP(8);
 					break;
 				}
 			}
@@ -3989,6 +4048,7 @@ IOService::probeCandidates( OSOrderedSet * matches )
 					personalityMatch = !personalityMatch;
 				}
 				if (!personalityMatch) {
+					NIO_DROP(9);
 					break;
 				}
 			}
@@ -3996,6 +4056,13 @@ IOService::probeCandidates( OSOrderedSet * matches )
 			// Check to see if driver reloc has been loaded.
 			needReloc = (false == gIOCatalogue->isModuleLoaded( match, &kextRef ));
 			if (needReloc) {
+				/* the kext that holds the personality is not loaded: the
+				 * matching waits for it.  (Which kext it is cannot be
+				 * printed here: the key that holds it is a symbol that
+				 * is a plain pointer in this build, and reading it
+				 * through the wrong type does not compile.  The class
+				 * name below says which personality it was.) */
+				NIO_DROP(6);
 #if IOMATCHDEBUG
 				if (debugFlags & kIOLogCatalogue) {
 					LOG("%s: stalling for module\n", getName());
@@ -4028,6 +4095,7 @@ IOService::probeCandidates( OSOrderedSet * matches )
 			}
 			if (familyMatches) {
 				familyMatches->setObject( props );
+				nio_kept++;
 			}
 		} while (false);
 
@@ -4035,6 +4103,27 @@ IOService::probeCandidates( OSOrderedSet * matches )
 		OSSafeReleaseNULL(nextMatch);
 		OSSafeReleaseNULL(props);
 	}
+
+	/* nio: the summary of the doors above, one line per nub that dropped
+	 * every candidate it was offered.  The reasons are single digits, in the
+	 * order the candidates were offered; the name is the class of the
+	 * candidate that was turned away for the most interesting reason. */
+	if (nio_nreasons && !nio_kept) {
+		char nio_buf[24];
+		int nio_i, nio_o = 0;
+		nio_buf[0] = '\0';
+		for (nio_i = 0; nio_i < nio_nreasons && nio_o < 20; nio_i++) {
+			nio_buf[nio_o++] = (char)('0' + nio_reasons[nio_i]);
+			nio_buf[nio_o] = '\0';
+			if (nio_i + 1 < nio_nreasons) {
+				nio_buf[nio_o++] = ',';
+				nio_buf[nio_o] = '\0';
+			}
+		}
+		printf("\nnio: S %s r=%s n=%s", getName() ? getName() : "?", nio_buf,
+		    nio_best_name[0] ? nio_best_name : "?");
+	}
+
 	OSSafeReleaseNULL(matches);
 	OSSafeReleaseNULL(rematchCountProp);
 
