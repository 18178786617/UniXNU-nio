+	if (nio_nreasons && !nio_kept) {
+		char nio_buf[48];
+		int nio_i, nio_o = 0;
+		nio_buf[0] = '\0';
+		for (nio_i = 0; nio_i < nio_nreasons && nio_o < 40; nio_i++) {
+			nio_buf[nio_o++] = (char)('0' + nio_reasons[nio_i]);
+			nio_buf[nio_o] = '\0';
+			if (nio_i + 1 < nio_nreasons) {
+				nio_buf[nio_o++] = ',';
+				nio_buf[nio_o] = '\0';
+			}
+		}
+		printf("\nnio: S %s r=%s", getName() ? getName() : "?", nio_buf);
+	}
+
 	OSSafeReleaseNULL(matches);
