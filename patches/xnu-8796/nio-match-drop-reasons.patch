+					if (nio_nreasons < 16) nio_reasons[nio_nreasons++] = 7;
 					break;
 				}
 			}
@@ -3980,6 +3989,7 @@ IOService::probeCandidates( OSOrderedSet * matches )
 					dextCount++;
 				}
 				if (categoryConsumed) {
+					if (nio_nreasons < 16) nio_reasons[nio_nreasons++] = 8;
 					break;
 				}
 			}
@@ -3989,6 +3999,7 @@ IOService::probeCandidates( OSOrderedSet * matches )
 					personalityMatch = !personalityMatch;
 				}
 				if (!personalityMatch) {
+					if (nio_nreasons < 16) nio_reasons[nio_nreasons++] = 9;
