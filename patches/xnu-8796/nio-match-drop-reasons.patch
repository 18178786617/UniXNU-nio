+				nio_kept++;
 			}
 		} while (false);
 
@@ -4035,6 +4058,25 @@ IOService::probeCandidates( OSOrderedSet * matches )
 		OSSafeReleaseNULL(nextMatch);
 		OSSafeReleaseNULL(props);
 	}
