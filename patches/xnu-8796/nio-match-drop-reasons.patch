 	bool                        isDext;
 	bool                        categoryConsumed;
+	int                         nio_reasons[16];
+	int                         nio_nreasons = 0;
+	int                         nio_kept = 0;
 
 	rematchCountProp = NULL;
 	count = 0;
@@ -3928,9 +3931,11 @@ IOService::probeCandidates( OSOrderedSet * matches )
 			client = NULL;
 			isDext = (NULL != match->getObject(gIOUserServerNameKey));
