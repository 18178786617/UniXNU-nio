+				if (nio_nreasons < 16) nio_reasons[nio_nreasons++] = 1;
 				continue;
 			}
 			if (isDext && !gIODextRelaunchMax && rematchCountProp) {
+				if (nio_nreasons < 16) nio_reasons[nio_nreasons++] = 2;
 				continue;
 			}
 			newIsBoot = gIOCatalogue->personalityIsBoot(match);
@@ -3953,6 +3958,7 @@ IOService::probeCandidates( OSOrderedSet * matches )
 				existingIsBoot = client->propertyExists(gIOMatchedAtBootKey);
 				isReplacementCandidate = existingIsBoot && !newIsBoot;
 				if (!isDext && !isReplacementCandidate) {
+					if (nio_nreasons < 16) nio_reasons[nio_nreasons++] = 3;
 					break;
 				}
 			}
@@ -3960,17 +3966,20 @@ IOService::probeCandidates( OSOrderedSet * matches )
 			// create a copy now in case its modified during matching
 			props = OSDictionary::withDictionary(match, match->getCount());
 			if (NULL == props) {
+				if (nio_nreasons < 16) nio_reasons[nio_nreasons++] = 4;
