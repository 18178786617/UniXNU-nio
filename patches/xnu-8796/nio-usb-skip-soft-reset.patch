nio: do not soft-reset the DWC3 controller (it wedges the boot)

Run 654's panel stopped at 'GS before soft reset' and never reached
'soft reset done': the DCTL.CSFTRST write hangs this board when issued
from the boot path.  Run 650 already proved ABL leaves the controller
powered, clocked and in device mode with a valid GSNPSID, so a reset is
unnecessary -- configure the endpoints on the state ABL left behind.

diff --git a/bsd/dev/nio_usb.c b/bsd/dev/nio_usb.c
--- a/bsd/dev/nio_usb.c
+++ b/bsd/dev/nio_usb.c
@@ -473,13 +473,15 @@ nio_usb_gadget_start(vm_offset_t dwc)
 	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
 	printf("nio: USB: GS before soft reset\n");
+#if 0
+	/* nio: DCTL.CSFTRST wedges the board (654); ABL already left the
+	 * controller in device mode with clocks on, so do not reset it. */
 	dwc_wr(DCTL, DCTL_CSFTRST);
 	int i;
 	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
 		delay(1000);
 	}
+#endif
+	int i = 0;
 	printf("nio: USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
-	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
-	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
-		return;
-	}
+	    "skipped", i, dwc_rd(GCTL), dwc_rd(DCFG));
 
 	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
