Name the service that is kicked into asynchronous matching

startDeferredMatches is compiled out here, so the repeating match must come from
this loop over allSet; its names say which services ask for it.
---
diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 6d7dd7e..cc4c24d 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -1236,6 +1236,7 @@ IOService::catalogNewDrivers( OSOrderedSet * newTables )
 
 	if (allSet) {
 		while ((service = (IOService *) allSet->getAnyObject())) {
+			printf("\nnio: AS %s", service->getName() ? service->getName() : "?");
 			service->startMatching(kIOServiceAsynchronous);
 			allSet->removeObject(service);
 		}
