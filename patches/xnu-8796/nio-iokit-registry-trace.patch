Name the service that cannot reach the registry root, and bound the walk

apfs finishes its sysctl registration and the console then goes completely
silent: no IOKit line, no kext line, nothing.  The earlier build at least
printed "not registry member at registerService()" at that point; this one
does not, and the only early return in that path is the one after the walk
up the IOService plane.  A cyclic or dangling parent chain would spin in
that while loop forever, print nothing, and look exactly like this.

So: bound the walk at 32 levels instead of trusting it to terminate, and
report the object that hit the bound with a CYCLE token.  The early return
now also carries the object name, the walk depth and its first three
ancestors, so a plain refusal is distinguishable from a stalled chain.

Rq is one receipt per 64 registerService calls, R0 is once with the root
and the platform expert.  All tokens are two or three characters.

---

diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -1037,13 +1037,48 @@ IOService::registerService( IOOptionBits options )
 	enum { kMaxPathLen  = 256 };
 	enum { kMaxChars    = 63 };
 
+	{
+		static bool nio_r0 = false;
+		static unsigned nio_rq = 0;
+		if (!nio_r0) {
+			nio_r0 = true;
+			IOLog("nio: R0 root=%p plat=%p\n",
+			    (void *)getRegistryRoot(), (void *)gIOPlatform);
+		}
+		/* nio: one receipt per 64 calls, so a stall inside registerService
+		 * still leaves a trace of how many services got processed. */
+		if (((++nio_rq) & 63u) == 0) {
+			const char *nio_rn = getName();
+			IOLog("nio: Rq %u %s\n", nio_rq, nio_rn ? nio_rn : "?");
+		}
+	}
 	IORegistryEntry * parent = this;
 	IORegistryEntry * root = getRegistryRoot();
+	int nio_up = 0;
+	/* nio: a cyclic or dangling parent chain spins here forever and never
+	 * reaches the early return, which is the silent stall seen right after
+	 * apfs registers its sysctls.  Bound the walk and break instead. */
 	while (parent && (parent != root)) {
+		if (++nio_up > 32) {
+			break;
+		}
 		parent = parent->getParentEntry( gIOServicePlane);
 	}
 
 	if (parent != root) {
+		const char *nio_n = getName();
+		IORegistryEntry *nio_q;
+		unsigned nio_k;
+
+		IOLog("nio: S1 %s up=%d%s p=%p r=%p g=%p\n",
+		    nio_n ? nio_n : "?", nio_up, (nio_up > 32) ? " CYCLE" : "",
+		    (void *)parent, (void *)root, (void *)gIOPlatform);
+		for (nio_q = getParentEntry(gIOServicePlane), nio_k = 1;
+		    nio_q != NULL && nio_k <= 3;
+		    nio_q = nio_q->getParentEntry(gIOServicePlane), nio_k++) {
+			const char *nio_pn = nio_q->getName();
+			IOLog("nio: U%u %s\n", nio_k, nio_pn ? nio_pn : "?");
+		}
 		IOLog("%s: not registry member at registerService()\n", getName());
 		return;
 	}
