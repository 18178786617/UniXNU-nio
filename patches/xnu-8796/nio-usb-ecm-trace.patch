nio: trace gadget_start steps in the ECM build

The ECM full-file patch dropped the earlier GS trace marks, so we cannot
see why the host reports "device descriptor request failed" (VID_0000).
Re-add a marker at each step: entry, ifnet create, event buffer, EP0 setup,
RUN_STOP, and thread start.  One photograph then names the exact step.

diff --git a/bsd/dev/nio_usb.c b/bsd/dev/nio_usb.c
index 03249e5..205c2c2 100644
--- a/bsd/dev/nio_usb.c
+++ b/bsd/dev/nio_usb.c
@@ -817,6 +817,7 @@ nio_usb_gadget_start(vm_offset_t dwc)
 {
 	thread_t thread;
 
+	printf("nio: USB: GS1 enter gadget_start\n");
 	ud.dwc = dwc;
 	if (kmem_alloc_contig(kernel_map, &ud.dma, UD_SIZE, PAGE_MASK, 0, 0,
 	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
@@ -828,13 +829,16 @@ nio_usb_gadget_start(vm_offset_t dwc)
 		return;
 	}
 	ud.dma_pa = ptoa_64(pn);
+	printf("nio: USB: GS2 if created, ifp=%p\n", (void *)ud.ifp);
 	ud_if_create();
+	printf("nio: USB: GS3 if setup done\n");
 
 	/* nio: skip CSFTRST -- it wedges the boot (654); ABL left the controller ready. */
 	int i = 0;
 	printf("nio: USB: soft reset skipped after 0 ms, GCTL 0x%08x DCFG 0x%08x\n",
 	    dwc_rd(GCTL), dwc_rd(DCFG));
 
+	printf("nio: USB: GS4 event buffer\n");
 	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
 	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
 	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);     /* interrupt masked: polled */
@@ -847,6 +851,7 @@ nio_usb_gadget_start(vm_offset_t dwc)
 	/* Events: disconnect, USB reset, connect done */
 	dwc_wr(DEVTEN, 0x7);
 
+	printf("nio: USB: GS5 before ep0 setup\n");
 	/* Endpoint 0 OUT/IN: start config, control type, max packet 512 until connect done. */
 	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
 	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
@@ -871,11 +876,13 @@ nio_usb_gadget_start(vm_offset_t dwc)
 		    usb_rd(qs, QSCRATCH_HS_PHY_CTRL), usb_rd(qs, QSCRATCH_SS_PHY_CTRL));
 	}
 
+	printf("nio: USB: GS6 before RUN_STOP\n");
 	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
 	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
 		delay(1000);
 	}
 	printf("nio: USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n", dwc_rd(DSTS), i, ud.dma_pa);
+	printf("nio: USB: GS7 thread start\n");
 	if (kernel_thread_start(ud_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
