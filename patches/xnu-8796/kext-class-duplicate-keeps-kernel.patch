diff --git a/libkern/c++/OSMetaClass.cpp b/libkern/c++/OSMetaClass.cpp
--- a/libkern/c++/OSMetaClass.cpp
+++ b/libkern/c++/OSMetaClass.cpp
@@ -888,13 +888,30 @@
 #if defined(XNU_TARGET_OS_OSX)
 					OSKextLog(myKext, kOSMetaClassLogSpec,
 #else
-					panic(
+					/* nio: on this board the storage class the incoming kext
+					 * redefines is already in the kernel, because the kernel
+					 * links IOStorageFamily's own compilation units
+					 * (scripts/build-storage-family.py) instead of loading the
+					 * family as a kext. Apple panics here and the machine is
+					 * gone before the driver runs. What the rest of the image
+					 * needs is the class, not the copy of it: OSMetaClass and
+					 * OSDynamicCast compare the meta class *pointer*, so the
+					 * registration that already happened is the one every
+					 * object in this image was compiled against, and it must
+					 * stay. The kext keeps its Info.plist personalities --
+					 * those are what make IOBlockStorageDriver, the partition
+					 * schemes and IOMediaBSDClient attach by class name -- and
+					 * loads without its own class table.
+					 */
+					OSKextLog(myKext, kOSMetaClassLogSpec,
 #endif /* defined(XNU_TARGET_OS_OSX) */
 					    "OSMetaClass: Kext %s class %s is a duplicate;"
 					    "kext %s already has a class by that name.",
 					    sStalled->kextIdentifier, (const char *)me->className,
 					    ((OSKext *)orig->reserved->kext)->getIdentifierCString());
+#if defined(XNU_TARGET_OS_OSX)
 					result = kOSMetaClassDuplicateClass;
+#endif /* defined(XNU_TARGET_OS_OSX) */
 					break;
 				}
 				unsigned int depth = 1;
