+/* nio: publish the personalities of the drivers that are linked into this
+ * kernel as static archives.
+ *
+ * A personality is normally published by OSKext, out of the kext's own info
+ * dictionary.  A static archive has no info dictionary: it is not a bundle,
+ * it is not in the prelink record, and there is no OSKext object for it, so
+ * nothing ever read the IOKitPersonalities in its Info.plist.  The two
+ * drivers on this board that matter -- the platform expert which reads the
+ * device tree, and the storage driver which talks to the UFS controller --
+ * were therefore never matched, their start() was never called, and their
+ * Info.plist files described wishes nobody heard.
+ *
+ * The catalogue is the one OSKext publishes into, and this is the moment to
+ * use it: the matching sweep reads what is in the catalogue when it starts.
+ *
+ * nio: and the moment is not this one any more.  The sweep that runs during
+ * the lockdown -- PE_lockdown_iokit() -- runs before bsd_init(), and this
+ * function is called from PE_init_platform(), which is after the lockdown.
+ * So the personalities were published into a catalogue that the sweep had
+ * already read: the lockdown sweep saw only the donor's personalities, the
+ * platform driver was never matched, no driver attached, the CPU count was
+ * never published, and the boot thread waited for it for ever.
+ *
+ * So the publication happens earlier -- from iokit_post_constructor_init(),
+ * right after the root nub is attached and long before the lockdown -- and
+ * this function calls it too, for the sweep that comes after the lockdown.
+ */
+static void
+nio_publish_static_personalities(void)
+{
+	static bool nio_published = false;
+
+	if (nio_published) {
+		return;
+	}
+	nio_published = true;
+
+	OSArray      *personalities = OSArray::withCapacity(3);
+	OSDictionary *platformExpert = OSDictionary::withCapacity(4);
+	OSDictionary *storage        = OSDictionary::withCapacity(3);
+	OSDictionary *storageRoot    = OSDictionary::withCapacity(3);
+	OSString     *classPlatform  = OSString::withCString("ArmDTPlatform");
+	OSString     *classStorage   = OSString::withCString("NioUfs");
+	OSString     *providerExpert = OSString::withCString("IOPlatformExpertDevice");
+	OSString     *providerDevice = OSString::withCString("IOPlatformDevice");
+	/*
+	 * The root nub takes its name from the device tree's root
+	 * node, and the kernel replaces that name with the first
+	 * string of the node's compatible property.  This board
+	 * forges the identity of another device, so that first string
+	 * is the board name and not the generic "device-tree" the
+	 * upstream driver was written against.  Taking the name from
+	 * the nub itself matches whatever the tree says, and the line
+	 * below says out loud what it was.
+	 */
+	const char   *rootName      = gRootNub->getName();
+	OSString     *nameMatch      = OSString::withCString(rootName ? rootName : "device-tree");
+	OSNumber     *scorePlatform  = OSNumber::withNumber(5000, 32);
+	OSNumber     *scoreStorage   = OSNumber::withNumber(1000, 32);
+	OSNumber     *scoreRoot      = OSNumber::withNumber(500, 32);
+
+	if (personalities && platformExpert && storage && storageRoot &&
+	    classPlatform && classStorage && providerExpert && providerDevice &&
+	    nameMatch && scorePlatform && scoreStorage && scoreRoot) {
+		platformExpert->setObject("IOClass", classPlatform);
+		platformExpert->setObject("IOProviderClass", providerExpert);
+		platformExpert->setObject("IONameMatch", nameMatch);
+		platformExpert->setObject("IOProbeScore", scorePlatform);
+		personalities->setObject(platformExpert);
+
+		storage->setObject("IOClass", classStorage);
+		storage->setObject("IOProviderClass", providerDevice);
+		storage->setObject("IOProbeScore", scoreStorage);
+		personalities->setObject(storage);
+
+		storageRoot->setObject("IOClass", classStorage);
+		storageRoot->setObject("IOProviderClass", providerExpert);
+		storageRoot->setObject("IOProbeScore", scoreRoot);
+		personalities->setObject(storageRoot);
+
+		printf("\nnio: publishing %d static personalities",
+		       (int) personalities->getCount());
+		gIOCatalogue->addDrivers(personalities, false);
+	}}
+
