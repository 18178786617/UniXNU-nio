Protect the kernel window at the end of pmap_init

The same pmap_protect placed at the top of pmap_init printed its line but the
stack write still faulted, so the pmap is not usable yet at that point.  Move
the call to the end of pmap_init.
---
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index bbd648e..fd82d90 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -2726,6 +2726,18 @@ pmap_init(
 	if ((uint32_t)hard_maxproc > pmap_max_asids) {
 		hard_maxproc = pmap_max_asids;
 	}
+
+	/*
+	 * nio: the boot thread runs on a stack nothing registered
+	 * (thread->kernel_stack == 0) and its first push faults with a
+	 * permission error.  Do this at the end of pmap_init, when the pmap
+	 * is usable; the same call placed earlier had no effect.
+	 */
+	pmap_protect(pmap_kernel(), VM_MIN_KERNEL_ADDRESS,
+	    VM_MIN_KERNEL_ADDRESS + 0x20000000ul,
+	    VM_PROT_READ | VM_PROT_WRITE);
+	printf("nio: kernel window %lx rw at pmap end\n",
+	    (unsigned long)VM_MIN_KERNEL_ADDRESS);
 }
 
