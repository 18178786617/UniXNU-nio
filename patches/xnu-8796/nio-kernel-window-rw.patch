Protect the boot stack window read/write

The boot thread's stack is the one the loader supplied and nothing registers it,
so the stack check finds kstk 0 / top 0, and the first push faults with a
permission error.  Protecting the whole low kernel window had no effect, so
protect the window derived from the current sp instead, at the end of pmap_init.
---
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index bbd648e..57f046e 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -2726,6 +2726,24 @@ pmap_init(
 	if ((uint32_t)hard_maxproc > pmap_max_asids) {
 		hard_maxproc = pmap_max_asids;
 	}
+
+	/*
+	 * nio: the boot thread's stack is the one the loader handed us, and
+	 * nothing registers it (thread->kernel_stack stays 0).  Its first
+	 * push faults with a permission error, so the page it lives on is
+	 * read-only by then.  Protect the window around the current sp.
+	 */
+	{
+		vm_offset_t nio_sp = (vm_offset_t)__builtin_frame_address(0);
+		vm_offset_t nio_page = trunc_page(nio_sp);
+		vm_offset_t nio_lo = nio_page - 0x40000;
+		vm_offset_t nio_hi = nio_page + 0x4000;
+		pmap_protect(pmap_kernel(), nio_lo, nio_hi,
+		    VM_PROT_READ | VM_PROT_WRITE);
+		printf("nio: boot stack %lx prot %lx..%lx rw\n",
+		    (unsigned long)nio_sp, (unsigned long)nio_lo,
+		    (unsigned long)nio_hi);
+	}
 }
 
