Protect the boot stack window, bootstrap-safe

The previous version used __builtin_frame_address and printf, which the
bootstrap link does not accept.  Take the address of a volatile local and use
plain arithmetic, and drop the print, so the minimal link stays intact.
---
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index bbd648e..9d8dcf8 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -2726,6 +2726,21 @@ pmap_init(
 	if ((uint32_t)hard_maxproc > pmap_max_asids) {
 		hard_maxproc = pmap_max_asids;
 	}
+
+	/*
+	 * nio: the boot thread runs on the loader's stack, nothing registers
+	 * it, and its first push faults with a permission error.  Protect the
+	 * window around the live frame; keep this to plain arithmetic so the
+	 * bootstrap link stays happy.
+	 */
+	{
+		volatile uint64_t nio_marker = 0;
+		uint64_t nio_sp = (uint64_t)(uintptr_t)&nio_marker;
+		uint64_t nio_page = nio_sp & ~(uint64_t)0x3fffull;
+		pmap_protect(pmap_kernel(), (vm_offset_t)(nio_page - 0x40000ull),
+		    (vm_offset_t)(nio_page + 0x4000ull),
+		    VM_PROT_READ | VM_PROT_WRITE);
+	}
 }
 
