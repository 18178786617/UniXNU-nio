nio: one-shot D ladder across the exec-tail blind spot (C03..C05)

699 photo stops at C03 exec_copy check; C04 (terminate new_task) absent,
so "new thread was reaped" is out. C05/C06 (FINAL_WAIT wake) and E06 never
appear, and no SEL lines follow C03 -- the CPU is spinning, not sleeping.
The C03..C05 window holds only three locking steps: INITIAL_WAIT clear,
turnstile watchport transfer, and task_terminate_internal(old_task). Fill
the whole window in one round (D01..D13), with the task_did_exec value,
old/new/current task pointers and a self_kill flag printed so a self-
terminate is proven on the panel. Whichever D mark is last pins the wedge.

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5295,24 +5295,46 @@
 	}
 
 	if (imgp != NULL) {
+		nio_emark("\nnio: D01 enter imgp block");
 		/* Clear the initial wait on the thread transferring watchports */
 		if (imgp->ip_new_thread) {
+			nio_emark("\nnio: D02 before INITIAL_WAIT");
 			task_clear_return_wait(get_threadtask(imgp->ip_new_thread), TCRW_CLEAR_INITIAL_WAIT);
+			nio_emark("\nnio: D03 after INITIAL_WAIT");
 		}
 
 		/* Transfer the watchport boost to new task */
 		if (!error) {
+			nio_emark("\nnio: D04 before turnstile");
 			task_transfer_turnstile_watchports(old_task,
 			    new_task, imgp->ip_new_thread);
+			nio_emark("\nnio: D05 after turnstile");
 		}
 		/*
 		 * Do not terminate the current task, if proc_exec_switch_task did not
 		 * switch the tasks, terminating the current task without the switch would
 		 * result in loosing the SIGKILL status.
 		 */
-		if (task_did_exec(old_task)) {
-			/* Terminate the current task, since exec will start in new task */
-			task_terminate_internal(old_task);
+		nio_emark("\nnio: D06 before task_did_exec");
+		{
+			int de = task_did_exec(old_task);
+			task_t ct = get_threadtask(current_thread());
+			nio_emark("\nnio: D07 did_exec=");
+			nio_ehex((unsigned)de);
+			nio_emark("\nnio: D08 old=");
+			nio_ehex64((unsigned long long)old_task);
+			nio_emark("\nnio: D09 new=");
+			nio_ehex64((unsigned long long)new_task);
+			nio_emark("\nnio: D10 cur=");
+			nio_ehex64((unsigned long long)ct);
+			nio_emark("\nnio: D11 self_kill=");
+			nio_ehex((unsigned)(ct == old_task));
+			if (de) {
+				/* Terminate the current task, since exec will start in new task */
+				nio_emark("\nnio: D12 before terminate old_task");
+				task_terminate_internal(old_task);
+				nio_emark("\nnio: D13 after terminate old_task");
+			}
 		}
 
 		/* Release the thread ref returned by cloneproc */
