nio: mark the steps inside cloneproc

The checkpoints of run 597 show "UT pre-cloneproc" but not
"UT post-cloneproc", so the boot is stuck inside cloneproc(),
which clones the init process.  It allocates a proc (forkproc),
then a task and thread (fork_create_child); one of those is not
coming back, but there is no mark to say which.

Put direct-to-framebuffer marks around forkproc() and
fork_create_child().  A small local console-ops struct is used
because this file does not include the header that declares it;
the layout is the two function pointers of cons_ops[].  The next
photograph will name the exact call that blocks.  No behaviour
changes.

diff --git a/bsd/kern/kern_fork.c b/bsd/kern/kern_fork.c
index ce9b516..8d7a803 100644
--- a/bsd/kern/kern_fork.c
+++ b/bsd/kern/kern_fork.c
@@ -668,6 +668,11 @@ fork(proc_t parent_proc, __unused struct fork_args *uap, int32_t *retval)
  *		live with this being somewhat awkward.
  */
 thread_t
+/* nio: unbuffered mark on the panel (no console lock). */
+struct nio_fork_console_ops { void (*putc)(char, bool); int (*getc)(bool); };
+extern struct nio_fork_console_ops cons_ops[];
+static void nio_fmark(const char *s) { while (*s) cons_ops[1].putc(*s++, true); }
+
 cloneproc(task_t parent_task, coalition_t *parent_coalitions, proc_t parent_proc, cloneproc_flags_t clone_flags)
 {
 #if !CONFIG_MEMORYSTATUS
@@ -679,7 +684,9 @@ cloneproc(task_t parent_task, coalition_t *parent_coalitions, proc_t parent_proc
 	bool memstat_internal = !!(clone_flags & CLONEPROC_FLAGS_MEMSTAT_INTERNAL);
 	bool in_exec = !!(clone_flags & CLONEPROC_FLAGS_FOR_EXEC);
 
+	nio_fmark("\nnio: CP pre-forkproc");
 	if ((child_proc = forkproc(parent_proc, clone_flags)) == NULL) {
+	nio_fmark("\nnio: CP post-forkproc");
 		/* Failed to allocate new process */
 		goto bad;
 	}
@@ -697,7 +704,9 @@ cloneproc(task_t parent_task, coalition_t *parent_coalitions, proc_t parent_proc
 	const int parent_64bit_addr = parent_proc->p_flag & P_LP64;
 	const int parent_64bit_data = (parent_task == TASK_NULL) ? parent_64bit_addr : task_get_64bit_data(parent_task);
 
+	nio_fmark("\nnio: CP pre-fork_create_child");
 	child_thread = fork_create_child(parent_task,
+	nio_fmark("\nnio: CP post-fork_create_child");
 	    parent_coalitions,
 	    child_proc,
 	    parent_64bit_addr,
