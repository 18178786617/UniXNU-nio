# MOTO Edge S / nio / SM8250-AC: source-kernel configuration, first light.
#
# This is deliberately the small source-only baseline, not umi's phone profile:
# it builds a kernel that enters, takes the architectural timer and can start
# secondary cores. Storage, display, owner-root and userspace switches stay off
# until the boot reaches the console; each of them needs its own archive and its
# own qualified inputs, and turning one on now would only move the first failure
# further from the cause.
#
# The port's target is iOS 16.5 (build 20F66): Darwin 22.5.0, xnu-8796.101.5.
# The source kernel comes from the apple-oss-distributions/xnu tag
# xnu-8796.101.5, which the OS profile pins; see feeds.toml and the [os] block
# of os-profiles/ios-16.5-20F66/profile.toml. The patch series applied on top
# of it is patches/xnu-8796/series, and all 67 of its patches were verified to
# apply in order on the real tree.
#
# The board-level values below are inherited from umi (Hello/Setup, touch, UFS,
# persistent Data) rather than re-derived, which is why they are here at all.
# Every deviation from the inherited baseline is called out with its reason.

# ArmCpu requires a source crypto provider and ArmDTPlatform.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# "prelinked", matching every os profile and alioth: the source provider stays
# linked for symbols, but prng_random.o is compiled with -UXNU_SOURCE_CORECRYPTO14
# so the STARTUP bootstrap that hand-drives corecrypto_kext_start is not built.
# With =source the bootstrap ran corecrypto_kext_start after the PRNG was already
# initialized and register_and_init_prng hit assert(!prng_ready) (prng_random.c:267,
# measured on hardware 2026-11-03). In this mode the original corecrypto kext starts
# through real OSKext startup, exactly once, and its own FIPS POST validates its
# untouched __text.
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"

# No QEMU platform and no unqualified sheng hardware/root-volume paths.
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_SHENG_PMGR=n

# Storage: nio's userdata is LUN 4 of a 6-LUN UFS and the inherited host driver
# only speaks LUN 0. Keep this off until the selector exists; flipping it early
# just moves the failure from "no disk" to "wrong disk".
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n

# The OS profile turns these on for the full Hello image. R54 reached
# "Failed to mount root device @IOKitBSDInit.cpp:984": the kernel now needs a
# root. mockfs (bsd/miscfs/mockfs, in-tree source) mounts an N4KROOT image off
# the RAMDisk memory device as the root filesystem, which is how fuxi and
# gta4l reach userland on their boards.
CONFIG_XNU_TRUST_CACHE_RUNTIME=n
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_CACHE_STARTUP=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n

# Required with the BCM2837 build target: n falls back to its fixed panic PA.
# nio has ramoops at 0xaf000000, but that is the UEFI console window, not a
# validated pram node, so the flag keeps its safe value: with a DT that has no
# pram node the function returns instead of mapping the Pi's 0x3c0fc000.
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=n

# SM8250 implements PAN; copyin/copyout must manage it on exception entry.
CONFIG_XNU_NATIVE_PAN=y

# The kernel's screen channel is the injected console blob, not boot_progress.
#
# R149 tried CONFIG_XNU_BOOT_PROGRESS=y and that was wrong for this board:
#
#   * Upstream's build-xnu-4k-baseline.sh:84 refuses BOOT_PROGRESS=1 unless
#     XNU_NATIVE_UFS=1, XNU_OWNER_ROOT_AUDIT=1 and XNU_SOURCE_CORECRYPTO14=1
#     are all set. This board has no UFS and no owner-root audit -- nio's
#     userdata is LUN 4 of a 6-LUN UFS and the inherited host driver only
#     speaks LUN 0 -- so the build stops with "Boot progress requires the
#     audited UFS/owner-root and source-corecrypto build".
#   * boot_progress_bind() is only called from initialize_screen() in
#     osfmk/console/video_console.c, and the display personality below is off,
#     so the diagnostic would never learn the framebuffer address anyway.
#
# The 17.7.11 bring-up solved this without boot_progress: it injects a console
# blob into the kernel image itself (tools/patch-xnu-console.py plus
# tools/install-blob.py), which replaces console_putc with a routine that
# draws straight into the framebuffer the loader handed over, and hangs
# sysent[SYS_write] on the same routine so userland writes land on the screen
# too. That path needs no display personality and no storage, which is why it
# worked with this switch off (R56-R118 all ran with BOOT_PROGRESS=n).
#
# So the switch stays off, and the screen comes back through the blob.
CONFIG_XNU_BOOT_PROGRESS=n

# Display stays off. The UEFI firmware leaves a GOP surface at
# 0x9c000000, but the legacy path needs umi's absolute IOMobileFramebuffer
# bindings, which are not qualified for this kernel yet.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
# The GPU is on now, but only as far as mode 8 (power, clocks, GMU cold start,
# GX up). The Metal accelerator is not built on this board: the accelerator is
# an IOAccelerator subclass and this kernel has no IOAccelerator class at all
# (IOAcceleratorFamily2 is absent from this XNU tree), so the archive carries
# the driver half of NativeAdreno and the board probe, and the probe's mode 12
# stays compiled out.
#
# The archive path uses {tree}: xnu_env() substitutes it, so the value is
# absolute and satisfies both checks -- unixnu's in scripts/unixnu/kernel.py,
# which runs from the checkout root, and build-xnu-4k-baseline.sh, which runs
# from the tree. A relative path satisfied neither.
#
# scripts/build-xnu-4k-baseline.sh hard-codes build/adreno740/libAdreno740.a
# for this archive and ignores the value below, so the recipe writes it under
# that name. The A740 in the path is the catalog component's name, not this
# board's silicon: the silicon is an A650.
CONFIG_XNU_NATIVE_ADRENO=y
CONFIG_XNU_NATIVE_ADRENO_ARCHIVE="{tree}/build/adreno740/libAdreno740.a"
CONFIG_XNU_ADRENO_FIRMWARE_PROBE=n
CONFIG_XNU_ADRENO_PM4_PROBE=n
CONFIG_XNU_SMMU4K_PROBE=n
CONFIG_XNU_CONSTANT_UPLOADS_PROBE=n
CONFIG_XNU_NATIVE_OFFLINE_GPU=n

CONFIG_XNU_BUILD_ARCHIVES=y
# The link stubs. The GPU archive imports six names that no selected component
# defines (package/LinkStubs.c), and ld64 refuses to leave a weak_import
# undefined in a static kernel link, so the kernel link needs an answer for each
# of them. scripts/build-link-stubs.py compiles the file into
# build/link-stubs/libLinkStubs.a, and scripts/build-xnu-4k-baseline.sh appends
# this value to LD_KERNEL_ARCHIVES.
#
# {tree} is substituted by xnu_env() with the absolute path of the assembled tree,
# which is what the build script and the kernel's own link both need.
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/link-stubs/libLinkStubs.a"
