# MOTO Edge S / nio / SM8250-AC: source-kernel configuration, first light.
#
# This is deliberately the small source-only baseline, not umi's phone profile:
# it builds a kernel that enters, takes the architectural timer and can start
# secondary cores. Storage, display, owner-root and userspace switches stay off
# until the boot reaches the console; each of them needs its own archive and its
# own qualified inputs, and turning one on now would only move the first failure
# further from the cause.
#
# The port's target is iOS 16.5 (build 20F66): Darwin 22.5.0, xnu-8796.101.5.
# The source kernel comes from the apple-oss-distributions/xnu tag
# xnu-8796.101.5, which the OS profile pins; see feeds.toml and the [os] block
# of os-profiles/ios-16.5-20F66/profile.toml. The patch series applied on top
# of it is patches/xnu-8796/series, and all 67 of its patches were verified to
# apply in order on the real tree.
#
# The board-level values below are inherited from umi (Hello/Setup, touch, UFS,
# persistent Data) rather than re-derived, which is why they are here at all.
# Every deviation from the inherited baseline is called out with its reason.

# ArmCpu requires a source crypto provider and ArmDTPlatform.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# "prelinked", matching every os profile and alioth: the source provider stays
# linked for symbols, but prng_random.o is compiled with -UXNU_SOURCE_CORECRYPTO14
# so the STARTUP bootstrap that hand-drives corecrypto_kext_start is not built.
# With =source the bootstrap ran corecrypto_kext_start after the PRNG was already
# initialized and register_and_init_prng hit assert(!prng_ready) (prng_random.c:267,
# measured on hardware 2026-11-03). In this mode the original corecrypto kext starts
# through real OSKext startup, exactly once, and its own FIPS POST validates its
# untouched __text.
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"

# No QEMU platform and no unqualified sheng hardware/root-volume paths.
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_SHENG_PMGR=n

# Storage: nio's userdata is LUN 4 of a 6-LUN UFS. The inherited host driver
# only spoke LUN 0, but the board's own driver (drivers/NioUfs, ported from
# the sheng SM8550 one) speaks any LUN and reads the GPT on LUN 4, so the
# selector this comment used to wait for exists now (docs/UFS-PLAN.md, U5).
#
# With the switch on, the kernel links build/sheng-ufs/libShengUfs.a (the
# name build-xnu-4k-baseline.sh hard-codes; scripts/build-nio-ufs-archive.py
# lays the board archive down under it), publishes NioUfs as an IOKit
# platform device and attaches the root window to IOPlatformExpertDevice.
# The root volume is selected by UUID through payload.adt's
# root_match_volume_uuid.
CONFIG_XNU_NATIVE_UFS=y
# Run 722 died at the NativeVirtioBlock qualification gate because nio had
# overridden the arch profile's NATIVE_AES=y with n.  Alioth (same SM8250 +
# 21H461 stack) leaves the arch value on, and this board already selects the
# SoftwareAES component plus build-software-aes-bindings.py.  Turning it back
# on satisfies the NativeVirtioBlock / NATIVE_RAM_BLOCK prelink closure without
# another build-script exemption.
CONFIG_XNU_NATIVE_AES=y
# Run 721: OWNER_ROOT_AUDIT/TRUST need a provider for
# native_verified_block_root_authorized(); the NativeUfs gate exemption only
# silenced the build-time check, it did not supply the symbol.  Alioth selects
# VirtioMmioBlock for exactly this on the same 21H461 kernel, so do the same.
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y

# The OS profile turns these on for the full Hello image. R54 reached
# "Failed to mount root device @IOKitBSDInit.cpp:984": the kernel now needs a
# root. mockfs (bsd/miscfs/mockfs, in-tree source) mounts an N4KROOT image off
# the RAMDisk memory device as the root filesystem, which is how fuxi and
# gta4l reach userland on their boards.
#
# The trust cache runtime is the one that matters now: the build defines
# XNU_NATIVE_TRUST_CACHE, and patches/xnu-8796/native-trust-cache-runtime.patch
# turns the startup.c guard into
#   #if !defined(BCM2837) || (defined(XNU_NATIVE_TRUST_CACHE) && XNU_NATIVE_TRUST_CACHE)
# so trust_cache_runtime_init() runs on this board too. Without it the lock
# that trust_cache_rt_lock names stays zero-filled, can_sleep is clear, and
# the first query of the trust cache panics the kernel with "Taking
# non-sleepable RW lock with preemption enabled" (R234). With it the runtime
# is initialized and the 16.5 StaticTrustCache this board fetches is loaded.
#
# What the runtime cannot do is run without the security extensions. img4if and
# amfi are registered by AMFI, and libsa/bootstrap.cpp skips loading AMFI on
# this board (nio_skip_security_extensions=1, because img4's manifest-properties
# node is absent from a hand-built device tree). R258 booted the run-46 kernel
# and stopped at exactly that: the panic screen's message was
#   "image4 interface not available" @bsd/kern/kern_trustcache.c:253
# with the console's last lines still at firehose/log/kalloc init, because the
# framebuffer tap stops echoing there and only the panic screen draws again.
# patches/xnu-8796/nio-trust-cache-without-security-extensions.patch keeps the
# runtime and its lock initialised and drops both panics; the static cache load
# then has no version to ask about and returns. Nothing can consult the cache
# while AMFI is not loaded, so the state it leaves behind is the honest one.
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_NATIVE_CS_HASH_CACHE=n
# Run 723 still ended in the arm64 link with `native_verified_root_probe`
# undefined: no selected component defines it, and the signed probe archive
# this config used to name is not something this board can produce. The owner
# root binding is answered by NioUfs from the live IORegistry (the same gate
# exemption kernel.yml already grants NativeUfs), so turn the optional probe
# off rather than inventing a signature ceremony.
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
# The offline owner chain is keyed by volume UUID (build-xnu-4k-baseline.sh's
# PY_DATA_UUID gate). OWNER_DATA_MOUNT + NATIVE_RAM_BLOCK require a DATA UUID,
# and OWNER_BOOT_MANIFEST requires the OS ROOT UUID. ROOT is the OS window's own
# volume UUID, measured from the 21H461 userdata image and pinned in the OS
# profile [root] os_volume_uuid and board.toml root_match_volume_uuid. DATA is
# the OwnerData seed volume: this 21H461 userland was validated on alioth with
# this seed UUID, and native_ram_block_volume_seed() only logs, not fails, when
# a freshly built seed carries a different UUID.
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="8902BEB3-3922-43F2-A2E1-31F8C82758D9"
CONFIG_XNU_OWNER_ROOT_VOLUME_UUID="04769D26-2CA0-4825-B443-E2E5F88300F2"
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y

# Required with the BCM2837 build target: n falls back to its fixed panic PA.
# nio has ramoops at 0xaf000000, but that is the UEFI console window, not a
# validated pram node, so the flag keeps its safe value: with a DT that has no
# pram node the function returns instead of mapping the Pi's 0x3c0fc000.
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=n

# SM8250 implements PAN; copyin/copyout must manage it on exception entry.
# nio: PAN turns the boot-stack write into a permission fault (esr 0x9600004f).
# Test with it off; the comment above still applies once the stack is sorted.
CONFIG_XNU_NATIVE_PAN=y

# The kernel's screen channel is the injected console blob, not boot_progress.
#
# R149 tried CONFIG_XNU_BOOT_PROGRESS=y and that was wrong for this board:
#
#   * Upstream's build-xnu-4k-baseline.sh:84 refuses BOOT_PROGRESS=1 unless
#     XNU_NATIVE_UFS=1, XNU_OWNER_ROOT_AUDIT=1 and XNU_SOURCE_CORECRYPTO14=1
#     are all set. This board has no UFS and no owner-root audit -- nio's
#     userdata is LUN 4 of a 6-LUN UFS and the inherited host driver only
#     speaks LUN 0 -- so the build stops with "Boot progress requires the
#     audited UFS/owner-root and source-corecrypto build".
#   * boot_progress_bind() is only called from initialize_screen() in
#     osfmk/console/video_console.c, and the display personality below is off,
#     so the diagnostic would never learn the framebuffer address anyway.
#
# The 17.7.11 bring-up solved this without boot_progress: it injects a console
# blob into the kernel image itself (tools/patch-xnu-console.py plus
# tools/install-blob.py), which replaces console_putc with a routine that
# draws straight into the framebuffer the loader handed over, and hangs
# sysent[SYS_write] on the same routine so userland writes land on the screen
# too. That path needs no display personality and no storage, which is why it
# worked with this switch off (R56-R118 all ran with BOOT_PROGRESS=n).
#
# So the switch stays off, and the screen comes back through the blob.
CONFIG_XNU_BOOT_PROGRESS=n

# Display stays off. The UEFI firmware leaves a GOP surface at
# 0x9c000000, but the legacy path needs umi's absolute IOMobileFramebuffer
# bindings, which are not qualified for this kernel yet.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
# The GPU is on now, but only as far as mode 8 (power, clocks, GMU cold start,
# GX up). The Metal accelerator is not built on this board: the accelerator is
# an IOAccelerator subclass and this kernel has no IOAccelerator class at all
# (IOAcceleratorFamily2 is absent from this XNU tree), so the archive carries
# the driver half of NativeAdreno and the board probe, and the probe's mode 12
# stays compiled out.
#
# The archive path uses {tree}: xnu_env() substitutes it, so the value is
# absolute and satisfies both checks -- unixnu's in scripts/unixnu/kernel.py,
# which runs from the checkout root, and build-xnu-4k-baseline.sh, which runs
# from the tree. A relative path satisfied neither.
#
# scripts/build-xnu-4k-baseline.sh hard-codes build/adreno740/libAdreno740.a
# for this archive and ignores the value below, so the recipe writes it under
# that name. The A740 in the path is the catalog component's name, not this
# board's silicon: the silicon is an A650.
CONFIG_XNU_NATIVE_ADRENO=y
CONFIG_XNU_NATIVE_ADRENO_ARCHIVE="{tree}/build/adreno740/libAdreno740.a"
CONFIG_XNU_ADRENO_FIRMWARE_PROBE=n
CONFIG_XNU_ADRENO_PM4_PROBE=n
CONFIG_XNU_SMMU4K_PROBE=n
CONFIG_XNU_CONSTANT_UPLOADS_PROBE=n
CONFIG_XNU_NATIVE_OFFLINE_GPU=n

# The component recipes write the plain VirtioMmioBlock/RamBlock archives, not
# the signed verified bundles alioth publishes. Since VERIFIED_ROOT_PROBE is
# off on this board, point the transport at the archive that is actually built;
# the old verified-bundle pin made the link test a path that never existed.
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/virtio-mmio-block/libVirtioMmioBlock.a"
CONFIG_XNU_BUILD_ARCHIVES=y
# The link stubs. The GPU archive imports six names that no selected component
# defines (package/LinkStubs.c), and ld64 refuses to leave a weak_import
# undefined in a static kernel link, so the kernel link needs an answer for each
# of them. scripts/build-link-stubs.py compiles the file into
# build/link-stubs/libLinkStubs.a, and scripts/build-xnu-4k-baseline.sh appends
# this value to LD_KERNEL_ARCHIVES.
#
# {tree} is substituted by xnu_env() with the absolute path of the assembled tree,
# which is what the build script and the kernel's own link both need.
# Run 725 ended in the arm64 link with `ld: 18 duplicate symbols`: both
# libVirtioMmioBlock.a[3](original-bindings.o) and
# libStorageBindings.a[2](original-bindings.o) define the same absolute
# IOBlockStorageDevice aliases.  Since run 721 the board embeds those aliases
# in the transport archives the kernel force-loads, and
# build-xnu-4k-baseline.sh already keeps one exact definition by linking the
# raw RAM transport object instead of force-loading libRamBlock.a.  The old
# global alias archive is now a second, redundant definition, so drop it from
# the force-load list rather than choose between two copies of every slot.
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/link-stubs/libLinkStubs.a -Wl,-force_load,{tree}/build/verified-root/libVerifiedRoot.a -Wl,-force_load,{tree}/build/usbdebug/libUsbDebug.a"

# The storage base class. drivers/NioUfs subclasses IOBlockStorageDevice, which
# is not in XNU: it lives in the prelinked IOStorageFamily kext. Run 35 stopped at
#
#   "vtable for IOBlockStorageDevice", referenced from:
#       vtable for NioUfsBlock in libNioUfs.a[2](NioUfs.o)
#
# and compiling the class in is not the answer -- runs 40-44 did that and the
# boot panicked on a duplicate OSMetaClass instead. scripts/build-storage-bindings.py
# emits the original prelinked entry points as absolute symbols, one per dispatch
# slot the class owns, so the subclass keeps its own vtable while every inherited
# slot resolves to the code IOKit is actually running.
#
# libVerifiedRoot.a is force-loaded because it satisfies NioUfs's
# vr_open/vr_verify_block references, which the linker can only reach by
# force-loading the members that define them. The storage aliases themselves
# now come from the force-loaded transport archive (libVirtioMmioBlock.a),
# not from the standalone libStorageBindings.a: see the CONFIG_XNU_EXTRA_LD_ARCHIVES
# note above for the run 725 duplicate-symbol failure.
CONFIG_XNU_NATIVE_IOSTORAGE=y
