# Keep patches LF-only: CRLF breaks git apply on macOS runners.
*.patch text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.py text eol=lf
*.series text eol=lf
# The series files are named "series" without an extension, so *.series does
# not match them.
series text eol=lf
*.dts text eol=lf
*.dtsi text eol=lf
# The reference callback table the libpthread build compares against travels
# in scripts/, because the build runs inside the assembled tree and the tree
# carries scripts/ and nothing else.
scripts/reference/*.h text eol=lf
# The kernel configuration is read by the build as a text file: a CRLF line
# ending would make a value carry a trailing carriage return into the merged
# .config.
*defconfig text eol=lf
# The OS profiles' config fragments are read the same way. The pattern is
# anchored to the fragments directory so it does not reach unrelated files
# that happen to be named "config".
/os-profiles/**/configs/*.config text eol=lf
